[proc,macro_geni_spawn]
spotanim_map(smokepuff, npc_coord, 124, 0);
sound_synth(genie_appear, 1, 0);
npc_say("Greetings <text_gender("master", "mistress")> <displayname>!");
%npc_macro_event_target = uid;
// this matches this video: https://www.youtube.com/watch?v=el-h9hbSH80&t=293s
npc_setmode(playerfollow);

// Allstar-City: no random events. The Genie (409) is Allstar-Scape's "Allstar's Slave", which stands
// at home: the random-event AI (the ignored-genie timer and its disappear queues) is gone.
