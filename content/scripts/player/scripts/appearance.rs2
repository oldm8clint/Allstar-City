// Allstar-City: the stand/walk/run anims are Allstar-Scape's playerSE/SEW/SER (%allstar_anim_*),
// set by wielding a weapon, at login and by beer; the turn anims never change (Player.appendPlayerAppearance).
[proc,update_bas]
def_seq $stand = %allstar_anim_stand;
def_seq $walk = %allstar_anim_walk;
def_seq $run = %allstar_anim_run;
if ($stand = null) $stand = human_ready;
if ($walk = null) $walk = human_walk_f;
if ($run = null) $run = human_running;
readyanim($stand);
turnanim(human_turnonspot);
walkanim($walk);
walkanim_b(human_walk_b);
walkanim_l(human_walk_l);
walkanim_r(human_walk_r);
runanim($run);
buildappearance(worn);

[proc,.update_bas]
def_seq $stand = .%allstar_anim_stand;
def_seq $walk = .%allstar_anim_walk;
def_seq $run = .%allstar_anim_run;
if ($stand = null) $stand = human_ready;
if ($walk = null) $walk = human_walk_f;
if ($run = null) $run = human_running;
.readyanim($stand);
.turnanim(human_turnonspot);
.walkanim($walk);
.walkanim_b(human_walk_b);
.walkanim_l(human_walk_l);
.walkanim_r(human_walk_r);
.runanim($run);
.buildappearance(worn);

[proc,bas_set_all](seq $seq)
~bas_set($seq, $seq, $seq, $seq, $seq, $seq, $seq);

[proc,bas_set](seq $ready, seq $turn, seq $walkf, seq $walkb, seq $walkl, seq $walkr, seq $run)
readyanim($ready);
turnanim($turn);
walkanim($walkf);
walkanim_b($walkb);
walkanim_l($walkl);
walkanim_r($walkr);
runanim($run);
buildappearance(worn);

[proc,headicon_add](int $icon)
def_int $current = headicons_get;
def_int $bit = multiply(0x1, pow(2, $icon));
headicons_set(or($current, $bit));
buildappearance(worn);

[proc,headicon_del](int $icon)
def_int $current = headicons_get;
def_int $bit = multiply(0x1, pow(2, $icon));
headicons_set(and($current, sub($current, $bit)));
buildappearance(worn);

[proc,.headicon_del](int $icon)
def_int $current = .headicons_get;
def_int $bit = multiply(0x1, pow(2, $icon));
.headicons_set(and($current, sub($current, $bit)));
.buildappearance(worn);

[proc,headicon_exists](int $icon)(boolean)
def_int $current = headicons_get;
def_int $bit = pow(2, $icon);
if (and($current, $bit) = $bit) {
    return(true);
}
return(false);

[proc,headicons_clear]()
headicons_set(0);
buildappearance(worn);

[proc,.headicons_clear]()
.headicons_set(0);
.buildappearance(worn);

// Allstar-City: equipment changed (client ResetBonus/GetBonus/WriteBonus, SendWeapon, appearance)
[proc,update_all](obj $previous_weapon)
if (p_finduid(uid) = true) {
    p_animprotect(^false);
}
~update_bas; // update appearance
~update_bonuses; // update bonuses if
~update_weapon_category($previous_weapon); // the attack tab weapon category
~player_combat_stat; // update combat varps

[proc,.update_all](obj $previous_weapon)
if (.p_finduid(.uid) = true) {
    .p_animprotect(^false);
}
.cam_reset;
~.update_bas; // update appearance
~.update_bonuses; // update bonuses if
~.update_weapon_category($previous_weapon); // the attack tab weapon category
~.player_combat_stat; // update combat varps

[queue,update_all]
~update_all(null);
