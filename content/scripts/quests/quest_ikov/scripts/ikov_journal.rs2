[debugproc,iku]
if (p_finduid(uid) = false) { return; }
%ikov = calc(%ikov + 10);
~send_quest_progress(questlist:ikov, %ikov, ^ikov_completed_armadyl);
mes("Ikov stage increased to <tostring(%ikov)>");
[debugproc,ikd]
if (p_finduid(uid) = false) { return; }
%ikov = calc(%ikov - 10);
~send_quest_progress(questlist:ikov, %ikov, ^ikov_completed_armadyl);
mes("Ikov stage decreased to <tostring(%ikov)>");
