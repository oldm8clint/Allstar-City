[proc,duel_adjust_scoreboard](string $winner, int $winner_combat_level, string $loser, int $loser_combat_level)
%duel10 = %duel9;
%duel9 = %duel8;
%duel8 = %duel7;
%duel7 = %duel6;
%duel6 = %duel5;
%duel5 = %duel4;
%duel4 = %duel3;
%duel3 = %duel2;
%duel2 = %duel1;
%duel1 = "<$winner> (<tostring($winner_combat_level)> beat <$loser> (<tostring($loser_combat_level)>)";
