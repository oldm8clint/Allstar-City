// side interfaces are treated as modals for now. They will eventually be treated as overlays.
// since they're modals right now, they're protected by default.

// auto retaliate
[if_button,controls:com_2]
if_close; // closes interfaces in osrs
if (p_finduid(uid) = true) {
    p_stopaction; // https://oldschool.runescape.wiki/w/Update:Slayer_Cave_%26_High_Risk_Worlds
    %option_nodef = ^player_auto_retaliate_on;
    return;
}
%option_nodef = %option_nodef; // resync varp

[if_button,controls:com_3]
if_close; // might be strongqueued in osrs
if (p_finduid(uid) = true) {
    p_stopaction; // https://oldschool.runescape.wiki/w/Update:Slayer_Cave_%26_High_Risk_Worlds
    %option_nodef = ^player_auto_retaliate_off;
    return;
}
%option_nodef = %option_nodef; // resync varp


// Player run
[if_button,controls:com_4] 
if_close;
if (p_finduid(uid) = true) {
    p_clearpendingaction; // https://youtu.be/XhJ0tjJ9J60?t=62
    p_run(^player_run_off);
    return;
}
%option_run = %option_run; // resync varp

[if_button,controls:com_5]
if_close;
if (p_finduid(uid) = true) {
    p_clearpendingaction;
    if (runenergy < 100) {
        p_run(^player_run_off);
        return;
    }
    if (%tutorial = ^tutorial_open_player_controls) {
        %tutorial = ^tutorial_has_toggled_on_run;
        ~set_tutorial_progress;
    }
    p_run(^player_run_on);
    return;
}
%option_run = %option_run; // resync varp


// Emotes. Allstar-Scape's emote tab was a teleport menu (client.java L23769, labels from
// TextHandler): no emote animates. Each teleport button checks teleblock, then runs the ::command
// (so it counts towards the flood limit). Think is the custom "vengeance" and Cry the skillcape
// emote (content/scripts/allstar/ui/scripts/emotes.rs2). Panic ("mining") and Jig ("Shilo") had
// handlers that could never run: the button id arrives as 52050 / 52051 (misc.HexToInt reads the
// two bytes as hi * 1000 + lo). Every other emote button did nothing.
[if_button,controls:com_20] ~allstar_emote_teleport("home");
[if_button,controls:com_21] ~allstar_emote_teleport("Train");
[if_button,controls:com_16] ~allstar_emote_teleport("Shops");
[if_button,controls:com_17] ~allstar_emote_teleport("pkbox");
[if_button,controls:com_22] ~allstar_emote_teleport("gsmini");
[if_button,controls:com_23] ~allstar_emote_teleport("barrows");
[if_button,controls:com_15] ~allstar_emote_teleport("teampk");
[if_button,controls:com_19] ~allstar_emote_teleport("guilds");
[if_button,controls:com_24] ~allstar_emote_teleport("slayer");
[if_button,controls:com_18] ~allstar_emote_teleport("skill");
[if_button,controls:com_14] ~allstar_vengeance;
[if_button,controls:com_13] ~allstar_cape_emote;
