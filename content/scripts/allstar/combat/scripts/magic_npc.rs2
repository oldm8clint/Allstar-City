        }
    case 13011 : // Shadow burst
        if (~allstar_spell_level(64, 64) = true & ~allstar_runes(deathrune, 2, chaosrune, 4, airrune, 2, soulrune, 2) = true) {
            $hit = calc(5 + randominc(10));
            ~allstar_spell_cast(382, $at, -1, 250);
            ~allstar_rune_del(deathrune, 2);
            ~allstar_rune_del(chaosrune, 4);
            ~allstar_rune_del(soulrune, 2);
            ~allstar_rune_del(airrune, 2);
            ~allstar_stop_moving;
        }
    case 12999 : // Shadow blitz
        if (~allstar_spell_level(76, 76) = true & ~allstar_runes(deathrune, 2, bloodrune, 2, airrune, 2, soulrune, 2) = true) {
            $hit = calc(5 + randominc(13));
            ~allstar_spell_cast(381, $at, -1, 300);
            ~allstar_rune_del(deathrune, 2);
            ~allstar_rune_del(bloodrune, 2);
            ~allstar_rune_del(soulrune, 2);
            ~allstar_rune_del(airrune, 2);
            ~allstar_stop_moving;
        }
    case 13023 : // Shadow barrage
        if (~allstar_spell_level(88, 88) = true & ~allstar_runes(deathrune, 4, bloodrune, 2, airrune, 4, soulrune, 3) = true) {
            $hit = calc(5 + randominc(25));
            ~allstar_spell_cast(383, $at, -1, 600);
            ~allstar_rune_del(deathrune, 4);
            ~allstar_rune_del(bloodrune, 2);
            ~allstar_rune_del(soulrune, 3);
            ~allstar_rune_del(airrune, 4);
            ~allstar_stop_moving;
        }
    case 12901 : // Blood rush: heals the unclamped roll
        if (~allstar_spell_level(56, 56) = true & ~allstar_runes(deathrune, 2, bloodrune, 1, chaosrune, 2, null, 0) = true) {
            $hit = calc(6 + randominc(10));
            ~allstar_blood_heal($hit);
            ~allstar_spell_cast(373, $at, -1, 200);
            ~allstar_rune_del(deathrune, 2);
            ~allstar_rune_del(bloodrune, 1);
            ~allstar_rune_del(chaosrune, 2);
            ~allstar_stop_moving;
        }
    case 12919 : // Blood burst
        if (~allstar_spell_level(68, 68) = true & ~allstar_runes(deathrune, 2, bloodrune, 2, chaosrune, 4, null, 0) = true) {
            $hit = calc(6 + randominc(13));
            ~allstar_blood_heal($hit);
            ~allstar_spell_cast(376, $at, -1, 300);
            ~allstar_rune_del(deathrune, 2);
            ~allstar_rune_del(bloodrune, 2);
            ~allstar_rune_del(chaosrune, 4);
            ~allstar_stop_moving;
        }
    case 12911 : // Blood blitz
        if (~allstar_spell_level(80, 80) = true & ~allstar_runes(deathrune, 2, bloodrune, 4, null, 0, null, 0) = true) {
            $hit = calc(6 + randominc(14));
            ~allstar_blood_heal($hit);
            ~allstar_spell_cast(375, $at, -1, 400);
            ~allstar_rune_del(deathrune, 2);
            ~allstar_rune_del(bloodrune, 4);
            ~allstar_stop_moving;
        }
    case 12891 : // Ice barrage: takes 6 fire runes instead of the water ones
        if (~allstar_spell_level(94, 94) = true & ~allstar_runes(deathrune, 4, bloodrune, 2, waterrune, 6, null, 0) = true) {
            $hit = calc(5 + randominc(25));
            ~allstar_spell_cast(369, $at, 1979, 800);
            %as_pking = calc(map_clock + 15);
            ~allstar_rune_del(deathrune, 4);
            ~allstar_rune_del(bloodrune, 2);
            ~allstar_rune_del(firerune, 6);
            ~allstar_stop_moving;
        }
    case 12929 : // Blood barrage (level 90, the message says 92)
        if (~allstar_spell_level(90, 92) = true & ~allstar_runes(deathrune, 4, bloodrune, 4, soulrune, 1, null, 0) = true) {
            $hit = calc(6 + randominc(25));
            ~allstar_blood_heal($hit);
            ~allstar_spell_cast(377, $at, -1, 700);
            %as_pking = calc(map_clock + 15);
            ~allstar_rune_del(deathrune, 4);
            ~allstar_rune_del(bloodrune, 4);
            ~allstar_rune_del(soulrune, 1);
            ~allstar_stop_moving;
        }
    case 12037 : // Magic dart: no extra xp, the caster keeps walking
        if (~allstar_spell_level(50, 50) = true & ~allstar_runes(deathrune, 20, waterrune, 30, null, 0, null, 0) = true) {
            $hit = calc(6 + randominc(20));
            ~allstar_spell_cast(331, $at, 1978, 0);
            %as_pking = calc(map_clock + 15);
            ~allstar_rune_del(deathrune, 20);
            ~allstar_rune_del(waterrune, 30);
        }
    case 12871 : // Ice blitz (level 82)
        if (~allstar_spell_level(82, 82) = true & ~allstar_runes(deathrune, 2, bloodrune, 2, waterrune, 3, null, 0) = true) {
            $hit = calc(6 + randominc(14));
            ~allstar_gfx_id(368, coordx(coord), coordz(coord));
            ~allstar_spell_cast(367, $at, 1978, 500);
            %as_pking = calc(map_clock + 15);
            ~allstar_rune_del(deathrune, 2);
            ~allstar_rune_del(bloodrune, 2);
            ~allstar_rune_del(waterrune, 3);
            ~allstar_stop_moving;
        }
}
if (calc($enemyhp - $hit) < 0) {
    $hit = $enemyhp;
}
stat_advance(magic, calc($hit * 1000));
~allstar_npc_hit($hit, ^hitmark_damage);
npc_heropoints($hit);

// ---- shared spell helpers ----

// "You need a magic level of N to cast this spell." (N is sometimes not the real requirement)
[proc,allstar_spell_level](int $level, int $shown)(boolean)
if (stat(magic) >= $level) {
    return(true);
}
mes("You need a magic level of <tostring($shown)> to cast this spell.");
return(false);

// playerHasItemAmount for every rune (one stack holding at least the amount); null = not needed
[proc,allstar_runes](namedobj $r1, int $n1, namedobj $r2, int $n2, namedobj $r3, int $n3, namedobj $r4, int $n4)(boolean)
if (~allstar_has_rune($r1, $n1) = false | ~allstar_has_rune($r2, $n2) = false | ~allstar_has_rune($r3, $n3) = false | ~allstar_has_rune($r4, $n4) = false) {
    mes("You do not have enough runes to cast this spell.");
    return(false);
}
return(true);

[proc,allstar_has_rune](namedobj $rune, int $count)(boolean)
if ($rune = null) {
    return(true);
}
if (inv_total(inv, $rune) >= $count) {
    return(true);
}
return(false);

// deleteItem(rune, getItemSlot(rune), amount): the whole stack goes when it holds no more than that
[proc,allstar_rune_del](namedobj $rune, int $count)
if (inv_total(inv, $rune) > 0) {
    inv_del(inv, $rune, $count);
}

// inCombat, the graphic on the target's tile (as seen by the caster), the cast animation (-1: none)
// and the spell's own xp (N x current Magic level)
[proc,allstar_spell_cast](int $gfx, coord $at, int $anim, int $xp)
~allstar_incombat;
~allstar_gfx_id($gfx, coordx($at), coordz($at));
if ($anim ! -1) {
    ~allstar_anim_id($anim);
}
if ($xp > 0) {
    stat_advance(magic, calc($xp * stat(magic)));
}

// Blood spells on NPCs: playerLevel[3] += roll, but process() puts hitpoints back to NewHP every cycle,
// so the heal only stays when the caster also gets a hit update this cycle (BUG, reproduced)
[proc,allstar_blood_heal](int $amount)
%as_pheal = calc(%as_pheal + $amount);
