// Allstar-Scape magic on NPCs (client.java packet 131, C:21341-22557). npcs_rules.md section 3.3.
//
// The engine runs [queue,allstar_opnpct] as soon as the spell packet arrives (NODE_ALLSTAR_COMBAT):
// Allstar-Scape cast at once, from any distance, and most spells stop the caster where they stand.
// There is no cast delay. Every cast (even an unknown spell or one that failed its level or rune
// check) puts the NPC in combat with the caster and gives it a hit, 0 when nothing was cast.

[queue,allstar_opnpct](npc_uid $npc, int $spell)
if (npc_finduid($npc) = false) {
    return;
}
~allstar_magic_npc($spell);

[proc,allstar_magic_npc](int $spell)
if (coordx(npc_coord) ! coordx(coord) & coordz(npc_coord) ! coordz(coord)) {
    facesquare(npc_coord);
}
def_int $enemyhp = npc_stat(hitpoints);
def_boolean $ok = true;
if (npc_type = smoke_devil & stat(slayer) < 74) {
    $ok = false;
    mes("You need a slayer level of 75 to slay Smoke Devils.");
}
if (npc_type = barrows_giantspider & stat(slayer) < 64) {
    $ok = false;
    mes("You need a slayer level of 65 to slay Crypt Spyders.");
}
if (npc_type = slayer_abberant_spectre_2 & stat(slayer) < 84) {
    $ok = false;
    mes("You need a slayer level of 85 to slay Aberrant Spectors.");
}
if ($ok = false | npc_stat(hitpoints) = 10000) {
    mes("You can't attack a player's summoned npc!");
    return;
}
~allstar_arm_npc;
def_int $hit = 0;
def_int $roll = 0;
def_coord $at = npc_coord;
switch_int ($spell) {
    case 1152 : // Wind strike
        if (~allstar_spell_level(1, 1) = true & ~allstar_runes(mindrune, 1, airrune, 1, null, 0, null, 0) = true) {
            $hit = calc(1 + randominc(6));
            ~allstar_spell_cast(92, $at, 711, 15);
            ~allstar_rune_del(mindrune, 1);
            ~allstar_rune_del(airrune, 1);
            ~allstar_stop_moving;
        }
    case 1154 : // Water strike
        if (~allstar_spell_level(5, 5) = true & ~allstar_runes(waterrune, 1, airrune, 1, mindrune, 1, null, 0) = true) {
            $hit = calc(1 + randominc(8));
            ~allstar_spell_cast(95, $at, 711, 0);
            ~allstar_rune_del(waterrune, 1);
            ~allstar_rune_del(airrune, 1);
            ~allstar_rune_del(mindrune, 1);
            ~allstar_stop_moving;
        }
    case 1156 : // Earth strike
        if (~allstar_spell_level(9, 9) = true & ~allstar_runes(earthrune, 2, airrune, 1, mindrune, 1, null, 0) = true) {
            $hit = randominc(8);
            ~allstar_spell_cast(98, $at, 711, 35);
            ~allstar_rune_del(earthrune, 2);
            ~allstar_rune_del(airrune, 1);
            ~allstar_rune_del(mindrune, 1);
            ~allstar_stop_moving;
        }
    case 1158 : // Fire strike
        if (~allstar_spell_level(13, 13) = true & ~allstar_runes(firerune, 3, airrune, 2, mindrune, 1, null, 0) = true) {
            $hit = randominc(10);
            ~allstar_spell_cast(101, $at, 711, 45);
            ~allstar_rune_del(firerune, 3);
            ~allstar_rune_del(airrune, 2);
            ~allstar_rune_del(mindrune, 1);
            ~allstar_stop_moving;
        }
    case 1160 : // Wind bolt (level 13, the message says 17)
        if (~allstar_spell_level(13, 17) = true & ~allstar_runes(airrune, 2, chaosrune, 1, null, 0, null, 0) = true) {
            $hit = randominc(16);
            ~allstar_spell_cast(119, $at, 711, 60);
            ~allstar_rune_del(airrune, 2);
            ~allstar_rune_del(chaosrune, 1);
            ~allstar_stop_moving;
        }
    case 1163 : // Water bolt: no extra xp
        if (~allstar_spell_level(23, 23) = true & ~allstar_runes(waterrune, 2, airrune, 2, chaosrune, 1, null, 0) = true) {
            $hit = randominc(18);
            ~allstar_spell_cast(122, $at, 711, 0);
            %as_pking = calc(map_clock + 15);
            ~allstar_rune_del(waterrune, 2);
            ~allstar_rune_del(airrune, 2);
            ~allstar_rune_del(chaosrune, 1);
            ~allstar_stop_moving;
        }
    case 1166 : // Earth bolt
        if (~allstar_spell_level(29, 29) = true & ~allstar_runes(earthrune, 3, airrune, 2, chaosrune, 1, null, 0) = true) {
            $hit = randominc(20);
            ~allstar_spell_cast(125, $at, 711, 85);
            ~allstar_rune_del(earthrune, 3);
            ~allstar_rune_del(airrune, 2);
            ~allstar_rune_del(chaosrune, 1);
            ~allstar_stop_moving;
        }
    case 1169 : // Fire bolt
        if (~allstar_spell_level(35, 35) = true & ~allstar_runes(firerune, 4, airrune, 3, chaosrune, 1, null, 0) = true) {
            $hit = randominc(22);
            ~allstar_spell_cast(128, $at, 711, 100);
            ~allstar_rune_del(firerune, 4);
            ~allstar_rune_del(airrune, 3);
            ~allstar_rune_del(chaosrune, 1);
            ~allstar_stop_moving;
        }
    case 1172 : // Wind blast
        if (~allstar_spell_level(41, 41) = true & ~allstar_runes(airrune, 3, deathrune, 1, null, 0, null, 0) = true) {
            $hit = randominc(24);
            ~allstar_spell_cast(134, $at, 711, 120);
            %as_pking = calc(map_clock + 15);
            ~allstar_rune_del(airrune, 3);
            ~allstar_rune_del(deathrune, 1);
            ~allstar_stop_moving;
        }
    case 1175 : // Water blast: the water runes are never taken (deleteItem looks for air runes in their slot)
        if (~allstar_spell_level(47, 47) = true & ~allstar_runes(waterrune, 3, airrune, 3, deathrune, 1, null, 0) = true) {
            $hit = randominc(26);
            ~allstar_spell_cast(137, $at, 711, 135);
            %as_pking = calc(map_clock + 15);
            ~allstar_rune_del(airrune, 3);
            ~allstar_rune_del(deathrune, 1);
            ~allstar_stop_moving;
        }
    case 1177 : // Earth blast
        if (~allstar_spell_level(53, 53) = true & ~allstar_runes(waterrune, 3, earthrune, 4, deathrune, 1, null, 0) = true) {
            $hit = randominc(28);
            ~allstar_spell_cast(140, $at, 711, 150);
            %as_pking = calc(map_clock + 15);
            ~allstar_rune_del(waterrune, 3);
            ~allstar_rune_del(earthrune, 4);
            ~allstar_rune_del(deathrune, 1);
            ~allstar_stop_moving;
        }
    case 1181 : // Fire blast
        if (~allstar_spell_level(59, 59) = true & ~allstar_runes(waterrune, 4, firerune, 5, deathrune, 1, null, 0) = true) {
            $hit = randominc(30);
            ~allstar_spell_cast(131, $at, 711, 165);
            %as_pking = calc(map_clock + 15);
            ~allstar_rune_del(waterrune, 4);
            ~allstar_rune_del(firerune, 5);
            ~allstar_rune_del(deathrune, 1);
            ~allstar_stop_moving;
        }
    case 1183 : // Wind wave: checks 5 air, takes 4
        if (~allstar_spell_level(62, 62) = true & ~allstar_runes(airrune, 5, bloodrune, 1, null, 0, null, 0) = true) {
            $hit = randominc(34);
            ~allstar_spell_cast(160, $at, 711, 200);
            %as_pking = calc(map_clock + 15);
            ~allstar_rune_del(airrune, 4);
            ~allstar_rune_del(bloodrune, 1);
            ~allstar_stop_moving;
        }
    case 1185 : // Water wave: checks 5 air, takes 4
        if (~allstar_spell_level(65, 65) = true & ~allstar_runes(airrune, 5, bloodrune, 1, waterrune, 7, null, 0) = true) {
            $hit = randominc(35);
            ~allstar_spell_cast(163, $at, 711, 225);
            %as_pking = calc(map_clock + 15);
            ~allstar_rune_del(airrune, 4);
            ~allstar_rune_del(bloodrune, 1);
            ~allstar_rune_del(waterrune, 7);
            ~allstar_stop_moving;
        }
    case 1188 : // Earth wave: checks 5 air, takes 4; the earth runes are never taken
        if (~allstar_spell_level(70, 70) = true & ~allstar_runes(airrune, 5, bloodrune, 1, earthrune, 7, null, 0) = true) {
            $hit = randominc(36);
            ~allstar_spell_cast(166, $at, 711, 250);
            %as_pking = calc(map_clock + 15);
            ~allstar_rune_del(airrune, 4);
            ~allstar_rune_del(bloodrune, 1);
            ~allstar_stop_moving;
        }
    case 1189 : // Fire wave
        if (~allstar_spell_level(75, 75) = true & ~allstar_runes(airrune, 5, bloodrune, 1, firerune, 7, null, 0) = true) {
            $hit = randominc(38);
            ~allstar_spell_cast(157, $at, 711, 300);
            %as_pking = calc(map_clock + 15);
            ~allstar_rune_del(airrune, 5);
            ~allstar_rune_del(bloodrune, 1);
            ~allstar_rune_del(firerune, 7);
            ~allstar_stop_moving;
        }
    case 1190 : // Saradomin strike: a Saradomin staff must be in the inventory
        if (~allstar_spell_level(60, 60) = true & ~allstar_runes(firerune, 2, bloodrune, 2, airrune, 4, saradomin_staff, 1) = true) {
            $hit = calc(1 + randominc(40));
            ~allstar_spell_cast(76, $at, 811, 500);
            %as_pking = calc(map_clock + 15);
            ~allstar_rune_del(firerune, 2);
            ~allstar_rune_del(bloodrune, 2);
            ~allstar_rune_del(airrune, 4);
            ~allstar_stop_moving;
        }
    case 1191 : // Claws of Guthix: checks 1 fire, takes 2
        if (~allstar_spell_level(60, 60) = true & ~allstar_runes(firerune, 1, bloodrune, 2, airrune, 4, null, 0) = true) {
            $hit = calc(1 + randominc(40));
            ~allstar_spell_cast(77, $at, 811, 500);
            %as_pking = calc(map_clock + 15);
            ~allstar_rune_del(firerune, 2);
            ~allstar_rune_del(bloodrune, 2);
            ~allstar_rune_del(airrune, 4);
            ~allstar_stop_moving;
        }
    case 1539 : // Iban blast: everything but the hit also happens without the runes
        if (~allstar_spell_level(50, 50) = true) {
            if (~allstar_runes(firerune, 5, deathrune, 1, null, 0, null, 0) = true) {
                $hit = randominc(20);
            }
            ~allstar_incombat;
            %as_pking = calc(map_clock + 8);
            ~allstar_anim_id(708);
            stat_advance(magic, calc(500 * stat(magic)));
            ~allstar_gfx_id(87, coordx(coord), coordz(coord));
            ~allstar_gfx_id(88, coordx($at), coordz($at));
            ~allstar_rune_del(firerune, 4);
            ~allstar_rune_del(deathrune, 1);
            ~allstar_stop_moving;
        }
    case 12939 : // Smoke rush (no animation)
        if (~allstar_spell_level(50, 50) = true & ~allstar_runes(deathrune, 2, chaosrune, 2, firerune, 1, airrune, 1) = true) {
            $hit = calc(5 + randominc(10));
            ~allstar_spell_cast(385, $at, -1, 200);
            ~allstar_rune_del(deathrune, 2);
            ~allstar_rune_del(chaosrune, 2);
            ~allstar_rune_del(firerune, 1);
            ~allstar_rune_del(airrune, 1);
            ~allstar_stop_moving;
        }
    case 12963 : // Smoke burst
        if (~allstar_spell_level(62, 62) = true & ~allstar_runes(deathrune, 2, chaosrune, 4, firerune, 2, airrune, 2) = true) {
            $hit = calc(5 + randominc(13));
            ~allstar_spell_cast(389, $at, -1, 250);
            ~allstar_rune_del(deathrune, 2);
            ~allstar_rune_del(chaosrune, 4);
            ~allstar_rune_del(firerune, 2);
            ~allstar_rune_del(airrune, 2);
            ~allstar_stop_moving;
        }
    case 12951 : // Smoke blitz
        if (~allstar_spell_level(74, 74) = true & ~allstar_runes(deathrune, 2, bloodrune, 2, firerune, 2, airrune, 2) = true) {
            $hit = calc(5 + randominc(15));
            ~allstar_spell_cast(389, $at, -1, 250);
            ~allstar_rune_del(deathrune, 2);
            ~allstar_rune_del(bloodrune, 2);
            ~allstar_rune_del(firerune, 2);
            ~allstar_rune_del(airrune, 2);
            ~allstar_stop_moving;
        }
    case 12975 : // Smoke barrage
        if (~allstar_spell_level(86, 86) = true & ~allstar_runes(deathrune, 4, bloodrune, 2, firerune, 4, airrune, 4) = true) {
            $hit = calc(5 + randominc(25));
            ~allstar_spell_cast(391, $at, -1, 600);
            ~allstar_rune_del(deathrune, 4);
            ~allstar_rune_del(bloodrune, 2);
            ~allstar_rune_del(firerune, 4);
            ~allstar_rune_del(airrune, 4);
            ~allstar_stop_moving;
        }
    case 12861 : // Ice rush: the water runes are never taken
        if (~allstar_spell_level(58, 58) = true & ~allstar_runes(deathrune, 2, bloodrune, 2, waterrune, 2, null, 0) = true) {
            $hit = calc(5 + randominc(10));
            ~allstar_spell_cast(361, $at, -1, 200);
            ~allstar_rune_del(deathrune, 2);
            ~allstar_rune_del(bloodrune, 2);
            ~allstar_stop_moving;
        }
    case 12881 : // Ice burst (level 69, the message says 70)
        if (~allstar_spell_level(69, 70) = true & ~allstar_runes(deathrune, 2, chaosrune, 4, waterrune, 4, null, 0) = true) {
            $hit = calc(5 + randominc(13));
            ~allstar_spell_cast(363, $at, -1, 300);
            ~allstar_rune_del(deathrune, 2);
            ~allstar_rune_del(chaosrune, 4);
            ~allstar_rune_del(waterrune, 4);
            ~allstar_stop_moving;
        }
    case 12987 : // Shadow rush
        if (~allstar_spell_level(52, 52) = true & ~allstar_runes(deathrune, 2, chaosrune, 2, airrune, 1, soulrune, 1) = true) {
            $hit = calc(5 + randominc(8));
            ~allstar_spell_cast(379, $at, -1, 200);
            ~allstar_rune_del(deathrune, 2);
            ~allstar_rune_del(chaosrune, 2);
            ~allstar_rune_del(soulrune, 1);
            ~allstar_rune_del(airrune, 1);
