// Allstar-Scape prayers (client.java C:24194-24412 buttons, C:17447-17463 drain, C:5010-5055
// noprayer/newdrain/ResetProtPrayers). npcs_rules.md section 3.5.
//
// Only the protection prayers do anything, and only against players: while any of meleeOn/rangeOn/
// mageOn is set the player cannot be hit by player melee/ranged, and mageOn blocks player magic.
// There are no level requirements and no stat effects. The prayer icons are toggled by the client
// itself (the server never sets them), so they can disagree with the server's flags.
//
// %as_prayers: one bit per prayer flag (below) plus bit 15 DrainPray.
// %as_protect: the protectMelee/protectRange/protectMage flags (1/2/4). They are only changed by the
// three buttons: running out of prayer points or dying leaves them on (BUG, reproduced).

[if_button,prayer:prayer_thickskin] ~allstar_prayer_toggle(0, 40);
[if_button,prayer:prayer_strengthburst] ~allstar_prayer_toggle(1, 40);
[if_button,prayer:prayer_clarity] ~allstar_prayer_toggle(2, 40);
[if_button,prayer:prayer_rockskin] ~allstar_prayer_toggle(3, 30);
[if_button,prayer:prayer_superhumanstrength] ~allstar_prayer_toggle(4, 30);
[if_button,prayer:prayer_rapidrestore] ~allstar_prayer_toggle(6, 20);
[if_button,prayer:prayer_steelskin] ~allstar_prayer_toggle(9, 20);
[if_button,prayer:prayer_ultimatestrength] ~allstar_prayer_toggle(10, 20);
[if_button,prayer:prayer_incrediblereflexes] ~allstar_prayer_toggle(11, 20);

// Improved Reflexes: no noprayer() before it, and it only turns off while DrainPray is set
[if_button,prayer:prayer_improvedreflexes]
if (testbit(%as_prayers, 5) = 0) {
    %as_prayers = setbit(setbit(%as_prayers, 15), 5);
    ~allstar_newdrain(30);
} else if (testbit(%as_prayers, 15) = 1) {
    %as_prayers = clearbit(%as_prayers, 5);
}

// Rapid Heal: no newdrain() call
[if_button,prayer:prayer_rapidheal]
if (testbit(%as_prayers, 7) = 0) {
    ~allstar_noprayer;
    %as_prayers = setbit(setbit(%as_prayers, 15), 7);
} else {
    %as_prayers = clearbit(%as_prayers, 7);
}

// Protect Item: only turns on while no prayer drains
[if_button,prayer:prayer_protectitems]
if (testbit(%as_prayers, 15) = 0) {
    ~allstar_noprayer;
    %as_prayers = setbit(setbit(%as_prayers, 15), 8);
    ~allstar_newdrain(20);
} else if (testbit(%as_prayers, 8) = 1) {
    %as_prayers = clearbit(%as_prayers, 8);
}

// Protect from Magic: turns every other prayer off (server side), head icon 4
[if_button,prayer:prayer_protectfrommagic]
if (testbit(%as_prayers, 12) = 0) {
    ~allstar_noprayer;
    ~allstar_reset_prot_prayers;
    %as_protect = 4;
    %as_prayers = setbit(setbit(%as_prayers, 15), 12);
    ~allstar_newdrain(15);
    ~allstar_set_headicon(4);
    buildappearance(worn);
} else {
    %as_protect = clearbit(%as_protect, 2);
    %as_prayers = clearbit(%as_prayers, 12);
    ~allstar_set_headicon(0);
    buildappearance(worn);
}

// Protect from Missiles: head icon 2
[if_button,prayer:prayer_protectfrommissiles]
if (testbit(%as_prayers, 13) = 0) {
    ~allstar_noprayer;
    ~allstar_reset_prot_prayers;
    %as_prayers = setbit(setbit(%as_prayers, 15), 13);
    ~allstar_newdrain(15);
    ~allstar_set_headicon(2);
    %as_protect = 2;
    buildappearance(worn);
} else {
    %as_protect = clearbit(%as_protect, 1);
    %as_prayers = clearbit(%as_prayers, 13);
    ~allstar_set_headicon(0);
    buildappearance(worn);
}

// Protect from Melee: head icon 1, but no appearance update (it shows with the next one)
[if_button,prayer:prayer_protectfrommelee]
if (testbit(%as_prayers, 14) = 0) {
    ~allstar_noprayer;
    ~allstar_reset_prot_prayers;
    %as_prayers = setbit(setbit(%as_prayers, 15), 14);
    ~allstar_newdrain(15);
    ~allstar_set_headicon(1);
    %as_protect = 1;
} else {
    %as_prayers = clearbit(%as_prayers, 14);
    ~allstar_set_headicon(0);
    %as_protect = clearbit(%as_protect, 0);
}

// Thick Skin, Burst of Strength, Clarity of Thought, Rock Skin, Superhuman Strength, Rapid Restore,
// Steel Skin, Ultimate Strength, Incredible Reflexes
[proc,allstar_prayer_toggle](int $bit, int $drain)
if (testbit(%as_prayers, $bit) = 0) {
    ~allstar_noprayer;
    %as_prayers = setbit(setbit(%as_prayers, 15), $bit);
    ~allstar_newdrain($drain);
} else {
    %as_prayers = clearbit(%as_prayers, $bit);
}

// noprayer(): with no prayer flag set, Noprayer = true and DrainPray = false
[proc,allstar_noprayer]
if (and(%as_prayers, 0x7fff) = 0) {
    %as_noprayer = 1;
    %as_prayers = clearbit(%as_prayers, 15);
} else {
    %as_noprayer = 0;
}

// newdrain(): a new prayer's interval replaces a slower one; with no prayer on before it, it always does
[proc,allstar_newdrain](int $drain)
if ($drain > %as_praydrain & %as_noprayer = 0) {
    return;
}
%as_praydrain = $drain;

// ResetProtPrayers(): every prayer flag off (not meleeOn/rangeOn/mageOn, not DrainPray)
[proc,allstar_reset_prot_prayers]
%as_prayers = and(%as_prayers, 0x8000);

// process() C:17447: PrayerTimer counts down every cycle; with DrainPray set a point drains when it is
// at 1 or less, then it restarts at PrayerDrain. Out of points: every prayer flag off and a message.
[proc,allstar_prayer_drain]
~allstar_noprayer;
%as_praytimer = calc(%as_praytimer - 1);
if (testbit(%as_prayers, 15) = 1 & %as_praytimer <= 1 & stat(prayer) > 0) {
    %as_praytimer = %as_praydrain;
    stat_sub(prayer, 1, 0);
}
if (testbit(%as_prayers, 15) = 1 & stat(prayer) = 0) {
    %as_praytimer = 0;
    %as_prayers = clearbit(%as_prayers, 15);
    ~allstar_reset_prot_prayers;
    mes("You have run out of prayer points");
}
