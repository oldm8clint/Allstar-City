[proc,allstar_special_bar]
%sa_energy = calc(%as_special * 10);

[proc,allstar_special_npc](int $wep, int $hit)(int)
return($hit);

[proc,allstar_oneshot](int $wep, int $hit, int $enemyhp)(int)
if ($wep = 747 | $wep = 6527) {
    return($enemyhp);
}
return($hit);

