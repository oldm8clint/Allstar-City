// Allstar-Scape magic on players (client.java packet 249 C:21269, AttackMage C:27980-28710,
// attackPlayersWithin/attackNPCSWithin C:5448-5500). npcs_rules.md section 3.3.
//
// A spell on a player needs both players outside the safe zones and the target not praying Protect
// from Magic ("This player is in a safe zone and cannot be attacked" otherwise), and at most one
// cast per 20 cycles (mageTimer). Any spell passes those checks and then hits for whatever it rolled,
// 0 for the standard strikes/bolts/blasts/waves (not implemented on players) or a failed check.

[queue,allstar_opplayert](player_uid $target, int $spell)
if (.finduid($target) = false) {
    return;
}
~allstar_reset_attack_npc;
if (~allstar_nonwild(coord) = false & ~allstar_nonwild(.coord) = false & testbit(.%as_protect, 2) = 0) {
    if (map_clock >= %as_mageclock) {
        ~allstar_attack_mage($spell);
        %as_mageclock = calc(map_clock + 20);
    }
} else {
    mes("This player is in a safe zone and cannot be attacked");
}
if (.finduid($target) = false) {
    return;
}
// the tele other spells: the target gets the accept screen (nothing happens on accept); the
// "Lumbridge" button sends Falador too; the level checks always pass
if ($spell = 12455) {
    ~.allstar_teleother_request("Camelot");
    mes("You send a tele request to <.displayname>");
} else if ($spell = 12435) {
    ~.allstar_teleother_request("Falador");
    mes("You send a tele request to <.displayname>");
} else if ($spell = 12425) {
    ~.allstar_teleother_request("Falador");
    mes("You send a tele request to <.displayname>");
    ~allstar_stop_moving;
}

// teleOtherRequest: interface 12468 with the caster's name and the place
[proc,.allstar_teleother_request](string $place)
.strongqueue*(allstar_teleother_screen, 0)(displayname, $place);

[queue,allstar_teleother_screen](string $name, string $place)
if_settext(inter_251:com_89, $name);
if_settext(inter_251:com_91, $place);
~allstar_show_interface(12468);

// AttackMage, with .active_player the target
[proc,allstar_attack_mage](int $spell)
def_player_uid $target = .uid;
~allstar_anim_id(711);
facesquare(.coord);
def_int $enemyhp = .stat(hitpoints);
def_int $hit = 0;
if ($spell = 1539 & %allstar_rights >= 1 & %allstar_rights <= 3) {
    ~allstar_levitate;
}
if ($spell = 1158 & stat(hitpoints) >= 80) {
    // "Shock Wave" (Fire Strike button): ProjectileSpellPlayer's own r(30) hit is replaced below
    ~allstar_projectile_spell_player(448, 30, soulrune, 1, mindrune, 1, firerune, 3);
    if (.finduid($target) = true) {
        ~.allstar_gfx_id(481, coordx(.coord), coordz(.coord));
        ~.allstar_gfx_id(453, coordx(.coord), coordz(.coord));
    }
    $hit = calc(5 + randominc(25));
    ~allstar_attack_npcs_within(453, 30, 4);
    ~allstar_attack_players_within(453, 30, 4);
} else if ($spell = 1190 | $spell = 1191 | $spell = 1192) {
    $hit = ~allstar_god_spell($spell);
} else if ($spell = 12975) {
    // Smoke barrage (level 95, the message says 96)
    if (~allstar_spell_level(95, 96) = true & ~allstar_pvp_runes(deathrune, 10, bloodrune, 5, firerune, 15, airrune, 15) = true) {
        ~allstar_anim_id(1979);
        ~allstar_attack_players_within(391, 39, 10);
        $hit = calc(5 + randominc(25));
        if (.finduid($target) = true) {
            ~.allstar_poison_player;
            ~.allstar_incombat;
        }
        ~allstar_incombat;
        %as_pking = calc(map_clock + 7);
        mes("You poison the enemy.");
        ~allstar_rune_del(deathrune, 10);
        ~allstar_rune_del(bloodrune, 5);
        ~allstar_rune_del(firerune, 15);
        ~allstar_rune_del(airrune, 15);
        ~allstar_stop_moving;
    }
} else if ($spell = 12881) {
    // Ice burst: no level requirement
    if (~allstar_pvp_runes(deathrune, 10, bloodrune, 10, firerune, 15, null, 0) = true) {
        ~allstar_anim_id(1979);
        $hit = calc(5 + randominc(13));
        ~.allstar_poison_player;
        ~.allstar_entangle(20);
        ~.allstar_incombat;
        ~allstar_incombat;
        %as_pking = calc(map_clock + 7);
        ~allstar_gfx_id(363, coordx(.coord), coordz(.coord));
        .mes("You have been frozen!");
        mes("You poison and freeze the enemy!");
        ~allstar_rune_del(deathrune, 10);
        ~allstar_rune_del(bloodrune, 10);
        ~allstar_rune_del(firerune, 15);
        ~allstar_stop_moving;
    }
} else if ($spell = 12891) {
    $hit = ~allstar_ice_barrage_player;
} else if ($spell = 1156) {
    $hit = ~allstar_staff_strike(3, "You need Owner priveleges to cast this spell!");
} else if ($spell = 1152) {
    $hit = ~allstar_staff_strike(1, "You need Moderator priveleges to cast this spell!");
} else if ($spell = 1154) {
    $hit = ~allstar_staff_strike(2, "You need Admin priveleges to cast this spell!");
} else if ($spell = 12037) {
    $hit = ~allstar_staff_strike(4, "You need Owner priveleges to cast this spell!");
} else if ($spell = 12929) {
    // Blood barrage: the caster heals half the hit (capped at max hitpoints)
    if (~allstar_spell_level(92, 92) = true & ~allstar_pvp_runes(deathrune, 30, bloodrune, 30, soulrune, 10, null, 0) = true) {
        ~allstar_anim_id(1979);
        ~allstar_attack_players_within(377, 39, 10);
        $hit = calc(6 + randominc(24));
        ~allstar_newhp_heal(calc($hit / 2));
        if (.finduid($target) = true) {
            ~.allstar_incombat;
            .mes("Your life has been drained!");
        }
        ~allstar_incombat;
        %as_pking = calc(map_clock + 15);
        mes("You drain the enemys life and add it to yours.");
        ~allstar_rune_del(deathrune, 30);
        ~allstar_rune_del(bloodrune, 30);
        ~allstar_rune_del(soulrune, 10);
        ~allstar_stop_moving;
    }
} else if ($spell = 13023) {
    // Shadow barrage: +10 hitpoints (uncapped) that only stay because the caster is flagged for a
    // hit update, which replays the caster's own last hitDiff; 10 soul runes are taken unchecked
    if (~allstar_spell_level(88, 88) = true & ~allstar_pvp_runes(deathrune, 10, bloodrune, 5, airrune, 10, null, 0) = true) {
        ~allstar_anim_id(1979);
        ~allstar_attack_players_within(382, 39, 10);
        $hit = calc(9 + randominc(21));
        %as_pheal = calc(%as_pheal + 10);
        if (%as_phit = 0) {
            %as_phit = calc(%as_lasthit + 1);
            %as_phittype = ^hitmark_damage;
        }
        %as_pking = calc(map_clock + 25);
        ~allstar_rune_del(deathrune, 10);
        ~allstar_rune_del(bloodrune, 5);
        ~allstar_rune_del(airrune, 10);
        ~allstar_rune_del(soulrune, 10);
        ~allstar_stop_moving;
    }
} else if ($spell = 12871) {
    // Ice blitz (level 89, the message says 90)
    if (~allstar_spell_level(89, 90) = true & ~allstar_pvp_runes(deathrune, 20, bloodrune, 10, waterrune, 30, null, 0) = true) {
        ~allstar_anim_id(1978);
        $hit = calc(6 + randominc(20));
        ~.allstar_entangle(20);
        ~.allstar_incombat;
        ~allstar_incombat;
        ~allstar_gfx_id(368, coordx(coord), coordz(coord));
        ~allstar_gfx_id(367, coordx(.coord), coordz(.coord));
        .mes("You are frozen!");
        ~allstar_rune_del(deathrune, 20);
        ~allstar_rune_del(bloodrune, 10);
        ~allstar_rune_del(waterrune, 30);
        ~allstar_stop_moving;
    }
} else if ($spell = 12911) {
    // Blood blitz (level 81, the message says 82): heals the whole hit (capped)
    if (~allstar_spell_level(81, 82) = true) {
        if (inv_total(inv, deathrune) < 20 | inv_total(inv, bloodrune) < 30) {
            mes("You need 20 <oc_name(deathrune)> and 30 <oc_name(bloodrune)>");
        } else {
            ~allstar_anim_id(1978);
            $hit = calc(6 + randominc(24));
            ~allstar_newhp_heal($hit);
            ~.allstar_incombat;
            ~allstar_incombat;
            mes("You drain the enemys life and add it to yours");
            .mes("Your life is drained!");
            %as_pking = calc(map_clock + 25);
            ~allstar_rune_del(deathrune, 20);
            ~allstar_rune_del(bloodrune, 30);
            ~allstar_stop_moving;
        }
    }
} else if ($spell = 1592) {
    // Entangle (level 78, the message says 79)
    if (~allstar_spell_level(78, 79) = true & ~allstar_pvp_runes(naturerune, 8, earthrune, 10, waterrune, 10, null, 0) = true) {
        ~allstar_gfx_id(179, coordx(.coord), coordz(.coord));
        ~.allstar_entangle(20);
        ~.allstar_incombat;
        ~allstar_incombat;
        ~allstar_anim_id(711);
        %as_pking = calc(map_clock + 40);
        ~allstar_rune_del(naturerune, 8);
        ~allstar_rune_del(earthrune, 10);
        ~allstar_rune_del(waterrune, 10);
        ~allstar_stop_moving;
        .mes("A bind spell has been cast upon you!");
    }
} else if ($spell = 12445) {
    // Tele Block: no runes, until the target logs out
    if (~allstar_spell_level(85, 85) = true) {
        ~allstar_anim_id(1819);
        ~.allstar_teleblock;
        ~.allstar_incombat;
        ~allstar_incombat;
        %as_pking = calc(map_clock + 10);
        ~allstar_stop_moving;
    }
}
if (.finduid($target) = false) {
    return;
}
if (calc($enemyhp - $hit) < 0) {
    $hit = $enemyhp;
}
stat_advance(magic, calc($hit * 500));
stat_advance(hitpoints, $hit);
~.allstar_player_hit($hit, ^hitmark_damage);
.%as_killer = uid;
.%as_killerbow = 0;

// "Levitate/electrocute" (Iban Blast button, rights 1-3): the first cast lifts the caster into the air
// (stand animation 1501 from then on); every cast electrocutes the target for 1 + r(6), which the
// final hit (0) replaces, and entangles them
[proc,allstar_levitate]
if (%as_inair = 0) {
    ~allstar_stop_moving;
    ~allstar_anim_id(1500);
    mes("You rise to the air.");
    ~allstar_stand_anim(1501);
    ~allstar_set_action_timer(0);
    %as_inair = 1;
}
if (~allstar_action_timer = 0) {
    ~allstar_stop_moving;
    ~allstar_anim_id(1502);
    mes("You electricute <.displayname>!");
    .mes("You get electricuted!");
    ~.allstar_anim_id(3170);
    ~.allstar_entangle(20);
    ~allstar_stand_anim(1501);
}

[proc,allstar_stand_anim](int $id)
def_seq $seq = enum(int, seq, allstar_seq_ids, $id);
if ($seq ! null) {
    readyanim($seq);
    walkanim($seq);
    buildappearance(worn);
}

// Saradomin Strike / Claws of Guthix / Flames of Zamorak: the q3stage check is inverted, so only
// players who have NOT completed Spells Of The Gods can cast them (BUG, reproduced)
[proc,allstar_god_spell](int $spell)(int)
if (~allstar_q3stage < 0) {
    mes("You need to of completed Spells Of The Gods quest to use this spell.");
    return(0);
}
def_int $level = 60;
def_int $gfx = 76;
if ($spell = 1191) {
    $gfx = 77;
} else if ($spell = 1192) {
    $level = 99;
    $gfx = 78;
}
if (~allstar_spell_level($level, $level) = false) {
    return(0);
}
if (inv_total(inv, bloodrune) < 25) {
    mes("You do not have enough runes to cast this spell.");
    mes("You need 25 <oc_name(bloodrune)>");
    return(0);
}
def_int $hit = calc(5 + randominc(25));
~allstar_gfx_id(83, coordx(coord), calc(coordz(coord) + 1));
~allstar_gfx_id(83, coordx(coord), calc(coordz(coord) - 1));
~allstar_gfx_id(83, calc(coordx(coord) + 1), coordz(coord));
~allstar_gfx_id(83, calc(coordx(coord) - 1), coordz(coord));
~.allstar_gfx_id($gfx, coordx(.coord), coordz(.coord));
~.allstar_incombat;
~allstar_incombat;
%as_pking = calc(map_clock + 10);
if ($spell = 1190) {
    mes("SARA STRIKE!");
} else if ($spell = 1191) {
    mes("CLAWS OF GUTHIX!!");
}
~allstar_rune_del(bloodrune, 25);
~allstar_stop_moving;
return($hit);

// Spells Of The Gods (quest 3) stage: owned by the quests; 0 (not started) until they are ported
[proc,allstar_q3stage]()(int)
return(0);

// Ice barrage (level > 93): the rune check wants 60 water runes, the cast 60 fire runes (needs both)
[proc,allstar_ice_barrage_player]()(int)
if (stat(magic) <= 93) {
    mes("You need a magic level of 94 to cast this spell.");
    return(0);
}
if (inv_total(inv, deathrune) < 40 | inv_total(inv, bloodrune) < 40 | inv_total(inv, waterrune) < 60) {
    mes("You do not have enough runes to cast this spell.");
    mes("You need 40 <oc_name(deathrune)>, 40 <oc_name(bloodrune)> and 60 <oc_name(waterrune)>");
    return(0);
}
if (inv_total(inv, firerune) < 60) {
    return(0);
}
def_int $hit = calc(5 + randominc(25));
~allstar_anim_id(1979);
~.allstar_poison_player;
~.allstar_entangle(40);
~.allstar_incombat;
~allstar_incombat;
%as_pking = calc(map_clock + 7);
~allstar_gfx_id(369, coordx(.coord), coordz(.coord));
.mes("You have been frozen!");
mes("You poison and freeze the enemy!");
~allstar_rune_del(deathrune, 40);
~allstar_rune_del(bloodrune, 40);
~allstar_rune_del(firerune, 60);
~allstar_stop_moving;
return($hit);

// Mod/Admin/Owner Strike (Wind/Water/Earth Strike buttons) and the Slayer Dart (Magic Dart): staff only
// ($rights 4 = the dart: rights 3 and up). They try to take 4 death, 2 blood and 6 fire runes (the fire
// runes are looked for in the water runes' slot, so they are never taken).
[proc,allstar_staff_strike](int $rights, string $denied)(int)
def_int $need = $rights;
if ($need = 4) {
    $need = 3;
}
if (%allstar_rights < $need) {
    mes($denied);
    return(0);
}
def_player_uid $target = .uid;
def_int $hit = 0;
def_int $x = coordx(.coord);
def_int $z = coordz(.coord);
~.allstar_incombat;
if ($rights = 1) {
    ~allstar_anim_id(439);
    $hit = calc(5 + randominc(38));
    ~.allstar_entangle(50);
    ~allstar_gfx_id(187, $x, $z);
    ~allstar_gfx_id(77, $x, calc($z - 1));
    ~allstar_gfx_id(77, $x, calc($z + 1));
    ~allstar_gfx_id(77, calc($x - 1), $z);
    ~allstar_gfx_id(77, calc($x + 1), $z);
    ~allstar_gfx_id(582, calc($x + 1), calc($z + 1));
    ~allstar_gfx_id(346, $x, $z);
    .mes("Pwnt");
} else if ($rights = 2) {
    ~allstar_anim_id(439);
    $hit = calc(5 + randominc(50));
    ~.allstar_entangle(50);
    ~.allstar_poison_player;
    ~allstar_gfx_id(76, $x, calc($z - 1));
    ~allstar_gfx_id(76, $x, calc($z + 1));
    ~allstar_gfx_id(76, calc($x - 1), $z);
    ~allstar_gfx_id(76, calc($x + 1), $z);
    ~allstar_gfx_id(547, $x, $z);
    .mes("Pwnt!");
} else if ($rights = 3) {
    ~allstar_anim_id(1914);
    $hit = calc(5 + randominc(65));
    ~.allstar_poison_player;
    ~.allstar_teleblock;
    ~.allstar_entangle(50);
    ~allstar_gfx_id(292, $x, $z);
    ~allstar_gfx_id(292, $x, calc($z - 1));
    ~allstar_gfx_id(292, $x, calc($z + 1));
    ~allstar_gfx_id(292, calc($x - 1), $z);
    ~allstar_gfx_id(292, calc($x + 1), $z);
    ~allstar_gfx_id(311, coordx(coord), coordz(coord));
    ~allstar_gfx_id(287, $x, $z);
    ~.allstar_gfx_id(305, $x, $z);
    .mes("PWNT!!");
} else {
    ~allstar_anim_id(2927);
    $hit = calc(5 + randominc(80));
    ~.allstar_entangle(160);
    ~.allstar_poison_player;
    ~allstar_attack_players_within(437, 10, 10);
    ~allstar_gfx_id(572, coordx(coord), coordz(coord));
    ~allstar_gfx_id(571, coordx(coord), coordz(coord));
    ~allstar_gfx_id(582, calc($x + 1), calc($z + 1));
    ~allstar_gfx_id(287, $x, $z);
    if (.finduid($target) = true) {
        .mes("HOLY SHIT!!!!!!!!!!!!!!!!");
        .mes("YOU GOT FUCKIN PWNZORD!!!!!!!");
    }
}
~allstar_incombat;
~allstar_set_action_timer(10);
~allstar_rune_del(deathrune, 4);
~allstar_rune_del(bloodrune, 2);
~allstar_stop_moving;
return($hit);

// the rune check of the PvP spells: every rune needed, with the second line listing them
[proc,allstar_pvp_runes](namedobj $r1, int $n1, namedobj $r2, int $n2, namedobj $r3, int $n3, namedobj $r4, int $n4)(boolean)
if (~allstar_has_rune($r1, $n1) = true & ~allstar_has_rune($r2, $n2) = true & ~allstar_has_rune($r3, $n3) = true & ~allstar_has_rune($r4, $n4) = true) {
    return(true);
}
mes("You do not have enough runes to cast this spell.");
if ($r4 ! null) {
    mes("You need <tostring($n1)> <oc_name($r1)>, <tostring($n2)> <oc_name($r2)>, <tostring($n3)> <oc_name($r3)> and <tostring($n4)> <oc_name($r4)>");
} else if ($r3 ! null) {
    mes("You need <tostring($n1)> <oc_name($r1)>, <tostring($n2)> <oc_name($r2)> and <tostring($n3)> <oc_name($r3)>");
} else {
    mes("You need <tostring($n1)> <oc_name($r1)> and <tostring($n2)> <oc_name($r2)>");
}
return(false);

// ProjectileSpellPlayer (3 runes): fails only when ALL the runes are missing; the hit r(max) goes
// through the caster's own hitDiff field, 4 Magic xp per damage
[proc,allstar_projectile_spell_player](int $gfx, int $max, namedobj $r1, int $n1, namedobj $r2, int $n2, namedobj $r3, int $n3)
if (inv_total(inv, $r1) < $n1 & inv_total(inv, $r2) < $n2 & inv_total(inv, $r3) < $n3) {
    mes("You do not have enough runes to cast that spell.");
    return;
}
def_int $hit = randominc($max);
%as_lasthit = $hit;
stat_advance(magic, calc($hit * 4));
if (calc(.stat(hitpoints) - $hit) < 0) {
    $hit = .stat(hitpoints);
}
~.allstar_player_hit($hit, ^hitmark_damage);
~allstar_anim_id(711);
~allstar_rune_del($r1, $n1);
~allstar_rune_del($r2, $n2);
~allstar_rune_del($r3, $n3);
~allstar_set_action_timer(4);
~allstar_projectile_player($gfx, 50, 95, 43, 31);

// NewHP += amount, capped at the maximum hitpoints (the PvP blood spells): it takes effect with the
// next update like a negative hit
[proc,allstar_newhp_heal](int $amount)
%as_pnewhp = calc(%as_pnewhp + $amount);

// client.entangle/uberentangle/burst/blitz/barrage/rapture: EntangleDelay (walking refused)
[proc,.allstar_entangle](int $cycles)
.%as_entangle = calc(map_clock + $cycles);

// client.Teleblock: until logout
[proc,.allstar_teleblock]
.%allstar_teleblock = 1;
.mes("A teleblock has been cast on you!");
~.allstar_gfx_id(345, coordx(.coord), coordz(.coord));

[proc,.allstar_gfx_id](int $id, int $x, int $z)
def_spotanim $gfx = enum(int, spotanim, allstar_spotanim_ids, $id);
if ($gfx ! null) {
    spotanim_map($gfx, movecoord(.coord, calc($x - coordx(.coord)), 0, calc($z - coordz(.coord))), 0, 0);
}

[proc,.allstar_anim_id](int $id)
def_seq $seq = enum(int, seq, allstar_seq_ids, $id);
if ($seq ! null) {
    .anim($seq, 0);
}

// ---- area damage ----

// attackPlayersWithin(gfx, max, range): every other player within Euclidean range (any height) who is
// not in a safe zone gets r(max). The finishing blow check uses the CASTER's own hitDiff, so a target
// with fewer hitpoints than that dies outright (BUG, reproduced). KillerId = the caster.
// .active_player is used for the loop: callers find their target again afterwards.
[proc,allstar_attack_players_within](int $gfx, int $max, int $range)
def_int $damage = 0;
playerall;
while (.huntnext = true) {
    if (.uid ! uid & ~allstar_distance(.coord, coord) <= $range & ~allstar_nonwild(.coord) = false) {
        $damage = randominc($max);
        ~.allstar_gfx_id($gfx, coordx(.coord), coordz(.coord));
        if (calc(.stat(hitpoints) - %as_lasthit) < 0) {
            $damage = .stat(hitpoints);
        }
        ~.allstar_player_hit($damage, ^hitmark_damage);
        .%as_killer = uid;
        .%as_killerbow = 0;
    }
}

// attackNPCSWithin(gfx, max, range): every living NPC within range (not those at exactly 1000
// hitpoints) gets r(max) and fights back; each hit is also written to the caster's own hitDiff,
// which the next NPC's finishing blow check uses
[proc,allstar_attack_npcs_within](int $gfx, int $max, int $range)
def_int $damage = 0;
npc_huntall(coord, $range, 0);
while (npc_findnext = true) {
    if (%asn_dead = 0 & npc_stat(hitpoints) ! 1000 & ~allstar_distance(npc_coord, coord) <= $range) {
        $damage = randominc($max);
        ~allstar_gfx_id($gfx, coordx(npc_coord), coordz(npc_coord));
        if (calc(npc_stat(hitpoints) - %as_lasthit) < 0) {
            $damage = npc_stat(hitpoints);
        }
        %as_lasthit = $damage;
        ~allstar_arm_npc;
        ~allstar_npc_hit($damage, ^hitmark_damage);
    }
}
