// Allstar-Scape player combat state (client.java fields). Nothing here is saved: Allstar-Scape kept
// these in memory only (special energy starts at 100, teleblock lasts until logout, ...).
// protect=no: NPC routines and other players write them (hits, SafeMyLife, KillerId, ...).

// attacknpc / IsAttackingNPC: the NPC being attacked
[as_atknpc]
type=npc_uid
protect=no

// walking up to the NPC after an attack click
[as_approach]
type=npc_uid
protect=no

// lastmove when the attack started: a later step is a walk, which resets the attack
[as_movecheck]
protect=no

// LogoutDelay: the cycle from which the player may log out again
[as_logoutdelay]
protect=no

// AttackingOn / IsAttacking: the player being attacked
[as_atkplayer]
type=player_uid
protect=no

// LoopAttDelay: the cycle from which the next hit is allowed (the counter reached 1)
[as_loopatt]
protect=no

// PkingDelay: the cycle from which Attack() may run again (the counter reached 0)
[as_pking]
protect=no

// actionTimer: the cycle it reaches 0
[as_actiontimer]
protect=no

// specialAmount (0-100) and its regeneration counter; usingSpecial is %sa_attack
[as_special]
protect=no

[as_specdelay]
protect=no

// FightType: 1 accurate, 2 aggressive, 3 controlled, 4 defensive
[as_fighttype]
protect=no

// hitDiff + 1 waiting for the update (0 = none) and its hitsplat type; the last hit of a cycle wins
[as_phit]
protect=no

[as_phittype]
protect=no

// KillerId (null = the player itself): owner of the death drop and who gets the pk points
[as_killer]
type=player_uid
protect=no

// PoisonDelay (0 = not poisoned) / PoisonClear
[as_poisondelay]
protect=no

[as_poisonclear]
protect=no

// the active prayer's drain interval (PrayerDrain) and countdown (PrayerTimer)
[as_praydrain]
protect=no

[as_praytimer]
protect=no

// mageTimer: the cycle the next PvP spell may be cast
[as_mageclock]
protect=no

// DDS2Damg: cycle of the second special hit (0 = none), and its target (npc or player)
[as_spec2]
protect=no

[as_spec2npc]
type=npc_uid
protect=no

[as_spec2player]
type=player_uid
protect=no

// lastKill: name of the last player killed (no pk points for the same victim twice in a row)
[as_lastkill]
type=string
protect=no

// SafeMyLife: the ring of life is about to save the player
[as_saveme]
protect=no

// ring of life teleport cycle (0 = none)
[as_ringtele]
protect=no

// dropsitem: the Chaos Elemental takes the weapon off on the next cycle
[as_dropsitem]
protect=no

// IsDead: killed, death not applied yet
[as_dead]
protect=no

// safe zone overlay last sent: 1 safe, 2 wild
[as_zone]
protect=no

// spellbook: 0 modern, 2 ancient (client.emotes)
[as_spellbook]
protect=no

// Ice/Smoke/... "freeze" timers (EntangleDelay) are never read by Allstar-Scape: not kept.
