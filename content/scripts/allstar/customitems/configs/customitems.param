// Allstar-Scape item data read by other systems (set on custom items here; see gen/customitems.mjs).

// item.cfg name: what the server used for name-based rules, messages and the weapon tab
[allstar_name]
type=string
default=null

// Item.itemSellable
[allstar_sellable]
type=boolean
default=no

// client.twoHanderz: cannot be wielded while a shield is worn
[allstar_blocks_shield]
type=boolean
default=no

// client.GetCLAttack: level needed to wear
[allstar_req_attack]
type=int
default=1

// client.GetCLPrayer: level needed to wear
[allstar_req_prayer]
type=int
default=1

// client.GetCLFletching: level needed to wear
[allstar_req_fletching]
type=int
default=1

// client.GetCLWoodcutting: level needed to wear
[allstar_req_woodcutting]
type=int
default=1

// client.GetCLCooking: level needed to wear
[allstar_req_cooking]
type=int
default=1

// client.GetCLFishing: level needed to wear
[allstar_req_fishing]
type=int
default=1

// client.GetCLThieving: level needed to wear
[allstar_req_thieving]
type=int
default=1

// client.GetCLHitpoints: level needed to wear
[allstar_req_hitpoints]
type=int
default=1

// client.GetCLFarming: level needed to wear
[allstar_req_farming]
type=int
default=1

// client.GetCLSlayer: level needed to wear
[allstar_req_slayer]
type=int
default=1

// client.GetCLDefence: level needed to wear
[allstar_req_defence]
type=int
default=1

// client.GetCLStrength: level needed to wear
[allstar_req_strength]
type=int
default=1

// client.GetCLMagic: level needed to wear
[allstar_req_magic]
type=int
default=1

// client.GetCLRanged: level needed to wear
[allstar_req_ranged]
type=int
default=1
