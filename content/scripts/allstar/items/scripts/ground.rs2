// Allstar-Scape drop (packet 87, L23408-23429) and pickup (packet 236, L20802-20820).
// npc_item_handlers.md section 10. A dropped stack stays 120 cycles (60 s).

[opheld5,_]
~allstar_drop(last_item, last_slot);

// Untradeable items (6384 only) vanish; everything else drops as the player's ground item.
// (744 Heart crystal at 2780,3515 during Spells Of The Gods stage 5 belongs to that quest.)
[proc,allstar_drop](obj $obj, int $slot)
if ($obj = null) {
    return;
}
if (oc_param($obj, allstar_untradeable) = true) {
    mes("You drop the <~allstar_obj_name($obj)>, it vanishes into the ground.");
    inv_delslot(inv, $slot);
    return;
}
if (inv_getobj(inv, $slot) = $obj) {
    inv_dropslot(inv, coord, $slot, 120);
}

// The pickup packet is handled as it arrives: the player must already stand on the item's tile and
// have a free slot (even for a stack), otherwise nothing happens and there is no retry. The client
// walked there first, so a first click walks onto the item and a second click picks it up.
[apobj3,_]
if (distance(coord, obj_coord) ! 0) {
    p_walk(obj_coord);
    return;
}
~allstar_pickup;

[proc,allstar_pickup]
if (distance(coord, obj_coord) ! 0 | inv_freespace(inv) < 1) {
    return;
}
obj_takeitem(inv);
