// Development helpers for allstar/tests (debugprocs only run on non-production worlds).

// ::~npcnid <npc> stores the nearest such npc in %allstar_debug_npc (::getvar reads it back; the low
// 16 bits are the npc index the client sends with its npc options) and prints its position.
[debugproc,npcnid](npc $npc)
def_int $best = 100;
def_coord $at = null;
npc_findall(coord, $npc, 15, 0);
while (npc_findnext = true) {
    if (distance(coord, npc_coord) < $best) {
        $best = distance(coord, npc_coord);
        $at = npc_coord;
        %allstar_debug_npc = npc_uid;
    }
}
if ($at = null) {
    mes("npcnid none");
    return;
}
mes("npcnid <tostring(coordx($at))>,<tostring(coordz($at))>");

// ::~npcsjuna opens Juna's menu (object 6657, client.java L3416, player west of Juna) the way the
// objects port should: set %allstar_junatele, then ~allstar_selectoption
[debugproc,npcsjuna]
strongqueue(allstar_debug_juna, 0, 0);

[queue,allstar_debug_juna]
%allstar_junatele = 1;
~allstar_selectoption("Hello what do you want?", "Can I go through please?", "Ya ma.", "");

// ::~npcsstaff <level> sets the engine staff level, so a test can act as a player (rank 0 cannot
// run debugprocs or dev cheats afterwards)
[debugproc,npcsstaff](int $level)
setstaffmodlevel($level);
