// Allstar-Scape quests: the quest tab used as a welcome note (loadquestinterface, client.java
// L8528), the quest-complete scroll (showQuestCompleted, L8031) and quest 1's guard gate (L17541).
// Stages: 0 not started, 1..n in progress, -1 complete. The quest journal (quest()/loadquest) was
// never reachable: clicking a quest name does nothing.

// Called at login (from ~update_questlist) and by the quest dialogues.
[proc,allstar_loadquestinterface]
if_settext(questlist:com_1, "@red@Allstar-Scape");
if_settext(questlist:com_24, "@whi@Info");
if_settext(questlist:com_43, "");
if (%allstar_q1stage = -1) {
    if_settext(questlist:fortress, "@gre@Invisible Armour");
}
if (%allstar_q1stage >= 1) {
    if_settext(questlist:fortress, "@yel@Invisible Armour");
}
if (%allstar_q1stage = 0) {
    if_settext(questlist:fortress, "@whi@Thank you for choosing");
}
// quest 2 never shows its own name
if (%allstar_q2stage = -1 | %allstar_q2stage >= 1) {
    if_settext(questlist:cook, "@red@Allstar-Scape");
}
if (%allstar_q2stage = 0) {
    if_settext(questlist:cook, "@yel@Allstar-Scape");
}
if (%allstar_q3stage = -1) {
    if_settext(questlist:demon, "@gre@Spells Of The Gods");
}
if (%allstar_q3stage >= 1) {
    if_settext(questlist:demon, "@yel@Spells Of The Gods");
}
if (%allstar_q3stage = 0) {
    if_settext(questlist:demon, "@whi@We hope you have a great");
}
// quest 4 "The Story Of Ramen": q4stage is never set, so it is always 0
if_settext(questlist:doric, "@whi@Good time on our server =)");
if_settext(questlist:dragon, "");
if_settext(questlist:haunted, "          - Mod Allstar");
if_settext(questlist:gobdip, "");
if_settext(questlist:imp, "");
if_settext(questlist:squire, "");
