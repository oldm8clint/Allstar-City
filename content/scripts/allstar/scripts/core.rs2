// Allstar-Scape helpers shared by every Allstar-City system.

// client.addItem: non-stackable items are added one at a time whatever the amount, a free slot is
// needed even when adding to an existing stack, and stacks stop at 999,999,999 (maxItemAmount).
[proc,allstar_additem](namedobj $obj, int $count)(boolean)
if (inv_freespace(inv) < 1) {
    mes("Not enough space in your inventory.");
    return (false);
}
if (oc_stackable($obj) = false | $count < 1) {
    $count = 1;
}
def_int $total = inv_total(inv, $obj);
if (calc($total + $count) >= 999999999 | calc($total + $count) < 0) {
    $count = calc(999999999 - $total);
}
if ($count > 0) {
    inv_add(inv, $obj, $count);
}
return (true);

// client.addItem(id, n) where the caller ignores the result (the item is lost if there is no room)
[proc,allstar_give](namedobj $obj, int $count)
def_boolean $added = ~allstar_additem($obj, $count);

// Command teleports (Player.getNextPlayerMovement): instant, same height, no animation, walk queue
// reset. Queued so it still happens while the player is busy, as it did in Allstar-Scape.
[proc,allstar_telejump](int $x, int $z)
if_close;
strongqueue*(allstar_telejump, 0)(movecoord(coord, calc($x - coordx(coord)), 0, calc($z - coordz(coord))));

[queue,allstar_telejump](coord $dest)
p_telejump($dest);

// Teleports that check client.teleblock print this and stop.
[proc,allstar_teleblocked]()(boolean)
if (%allstar_teleblock = 1) {
    mes("A magical force stops you from teleporting.");
    return (true);
}
return (false);

// Allstar-Scape usernames were compared with equalsIgnoreCase.
[proc,allstar_is_named](string $name)(boolean)
if (compare(lowercase(displayname), lowercase($name)) = 0) {
    return (true);
}
return (false);

// Hidden points for the "secret commands quest": each foundz[] slot pays out once per account.
[proc,allstar_hidden_point](int $slot)
if (testbit(%allstar_found, $slot) = 1) {
    return;
}
%allstar_found = setbit(%allstar_found, $slot);
%allstar_hiddenpoints = calc(%allstar_hiddenpoints + 1);
mes("Hidden found");
mes("You gain a hidden point!");

// Text scrolls: Allstar-Scape's 317 scroll interface 8134 (title 8144, lines 8145, 8147-8195,
// 12174-12223) is questjournal in 377; see allstar_scroll_lines.
[proc,allstar_scroll_clear]
def_int $line = 0;
while ($line <= 99) {
    if_settext(enum(int, component, allstar_scroll_lines, $line), "");
    $line = calc($line + 1);
}

[proc,allstar_scroll_line](int $line, string $text)
if ($line >= 0 & $line <= 99) {
    if_settext(enum(int, component, allstar_scroll_lines, $line), $text);
}

// sendFrame126(text, child) for a 317 scroll child id
[proc,allstar_scroll_child](int $child, string $text)
if ($child = 8144) {
    if_settext(questjournal:com_3, $text);
} else if ($child = 8145) {
    ~allstar_scroll_line(0, $text);
} else if ($child >= 8147 & $child <= 8195) {
    ~allstar_scroll_line(calc($child - 8146), $text);
} else if ($child >= 12174 & $child <= 12223) {
    ~allstar_scroll_line(calc($child - 12124), $text);
}

// ---- ui workstream helpers ----

// client.showInterface (L10212): resetAnimation, then the interface.
[proc,allstar_showinterface](interface $interface)
~allstar_reset_stand;
if_openmain($interface);

// client.resetAnimation (L10123): the stand animation goes back to playerSE (%allstar_anim_stand:
// the wielded weapon's, beer's or ::god's), undoing ::sit and the owner ::emote.
[proc,allstar_reset_stand]
if (%allstar_anim_stand = null) {
    readyanim(human_ready);
} else {
    readyanim(%allstar_anim_stand);
}
buildappearance(worn);

// Integer.parseInt: an optional sign then decimal digits, within the int range. Returns
// (false, 0) where Java threw NumberFormatException.
[proc,allstar_parseint](string $text)(boolean, int)
def_int $length = string_length($text);
if ($length < 1) {
    return (false, 0);
}
def_int $i = 0;
def_boolean $negative = false;
def_int $limit = -2147483647;
def_string $first = substring($text, 0, 1);
if (compare($first, "-") = 0) {
    $negative = true;
    $limit = calc(-2147483647 - 1);
    $i = 1;
} else if (compare($first, "+") = 0) {
    $i = 1;
}
if ($i >= $length) {
    return (false, 0);
}
// accumulate negatively like Integer.parseInt so -2147483648 fits
def_int $multmin = calc($limit / 10);
def_int $result = 0;
def_int $digit = 0;
while ($i < $length) {
    $digit = string_indexof_string(substring($text, $i, calc($i + 1)), "0123456789");
    if ($digit < 0 | $result < $multmin) {
        return (false, 0);
    }
    $result = calc($result * 10);
    if ($result < calc($limit + $digit)) {
        return (false, 0);
    }
    $result = calc($result - $digit);
    $i = calc($i + 1);
}
if ($negative = true) {
    return (true, $result);
}
return (true, calc(0 - $result));

// An exception thrown inside client.customCommand reached packetProcess (L18056): the player was
// disconnected (and saved). Commands that call this must stop straight after.
[proc,allstar_crash]
%allstar_cmd_crashed = 1;
p_kick;

// client.actionTimer: the shared action cooldown in cycles. %allstar_action_timer counts down once
// per cycle in [softtimer,allstar_items_cycle] (process() L17028), so a packet handler sees what
// Allstar-Scape's packet handler saw, and the cycle code what process() saw.
[proc,allstar_action_timer]()(int)
return (%allstar_action_timer);

[proc,allstar_set_action_timer](int $cycles)
%allstar_action_timer = $cycles;

// client.inCombat: LogoutDelay = 2 cycles. The logout button refuses while it runs ("You must wait
// 10 seconds after combat to log out!"); closing the client was not held back.
[proc,allstar_incombat]
%allstar_logout_delay = calc(map_clock + 2);

// client.stillgfx(id, y, x): a graphic on a tile (the player's current height) for everyone near it.
[proc,allstar_stillgfx](spotanim $gfx, int $x, int $z)
spotanim_map($gfx, movecoord(coord, calc($x - coordx(coord)), 0, calc($z - coordz(coord))), 0, 0);

// client.nonWild (C:851-926): the safe zones. Every tile on height 1 is safe; the rest of the map
// is a PvP area. Rectangles with min > max never match and are left out.
[proc,allstar_nonwild](coord $coord)(boolean)
if (coordy($coord) = 1) {
    return (true);
}
def_int $x = coordx($coord);
def_int $z = coordz($coord);
if ($x >= 2847 & $x <= 2874 & $z >= 9830 & $z <= 9854) { return (true); }
if ($x >= 2401 & $x <= 2405 & $z >= 3098 & $z <= 3102) { return (true); }
if ($x >= 2820 & $x <= 2876 & $z >= 2950 & $z <= 3004) { return (true); }
if ($x >= 2667 & $x <= 2684 & $z >= 3717 & $z <= 3732) { return (true); }
if ($x >= 3033 & $x <= 3036 & $z >= 4842 & $z <= 4844) { return (true); }
if ($x >= 3229 & $x <= 3242 & $z >= 9796 & $z <= 9807) { return (true); }
if ($x >= 2442 & $x <= 2487 & $z >= 4808 & $z <= 4855) { return (true); }
if ($x >= 2581 & $x <= 2589 & $z >= 4834 & $z <= 4842) { return (true); }
if ($x >= 2712 & $x <= 2720 & $z >= 4832 & $z <= 4840) { return (true); }
if ($x >= 2654 & $x <= 2662 & $z >= 4837 & $z <= 4845) { return (true); }
if ($x >= 2837 & $x <= 2851 & $z >= 4826 & $z <= 4842) { return (true); }
