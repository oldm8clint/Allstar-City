// Allstar-Scape login and logout (client.run, client.initialize, Player constructor).

// First login: Player.java defaults. Home is 2852,3591; Hitpoints start at 98/14.
[proc,allstar_new_player]
if (%allstar_created = 1) {
    return;
}
%allstar_created = 1;
p_telejump(0_44_56_36_7);

// hitpoints xp 1155 (level 14 on the Allstar curve), current level 98
stat_advance(hitpoints, calc(1155 - ~allstar_new_player_hp_xp));
stat_add(hitpoints, calc(98 - stat(hitpoints)), 0);
healenergy(calc(0 - runenergy));

inv_setslot(worn, ^wearpos_hat, wolfenhat_crimson, 1);
inv_setslot(worn, ^wearpos_back, wilderness_cape_46, 1);
inv_setslot(worn, ^wearpos_front, enchanted_onyx_amulet, 1);
inv_setslot(worn, ^wearpos_torso, wolfenrobetop_crimson, 1);
inv_setslot(worn, ^wearpos_lhand, zamorakbook_complete, 1);
inv_setslot(worn, ^wearpos_legs, red_dragonhide_chaps, 1);
inv_setslot(worn, ^wearpos_hands, wolfengloves_crimson, 1);
inv_setslot(worn, ^wearpos_feet, wolfenboots_crimson, 1);
inv_setslot(worn, ^wearpos_rhand, dragon_scimitar, 1);

// playerLook / pHead.. defaults: colours hair 0, torso 1, legs 2, feet 0, skin 0
setidkit(man_head_spikeyhair, 0);
setidkit(man_jaw_none, 0);
setidkit(man_torso_elf, 1);
setidkit(man_arms_longsleeves2, 1);
setidkit(man_hands_demon, 1);
setidkit(man_legs_turnups, 2);
setidkit(man_feet_demon, 0);
setidkcolour(4, 0);

// Hitpoints xp given to a brand new Lost City character (level 10) before Allstar's defaults.
[proc,allstar_new_player_hp_xp]()(int)
return (583);

// Ranks live in the save (character-rights). The engine staff level is at least the Allstar rank.
[proc,allstar_login_rights]
if (%allstar_rights > staffmodlevel) {
    setstaffmodlevel(%allstar_rights);
}

// client.run L10863-10890: global login message
[proc,allstar_login_broadcast]
if (~allstar_is_named("Skillerzmine") = true | ~allstar_is_named("Fatality") = true | ~allstar_is_named("Mod Mike") = true) {
    world_broadcast("Co-owner <displayname> has logged in");
} else if (%allstar_rights = 3) {
    world_broadcast("Owner & Coder <displayname> has logged in");
} else if (%allstar_rights = 2) {
    world_broadcast("Server Administrator <displayname> has logged in");
} else if (%allstar_rights = 1) {
    world_broadcast("Moderator <displayname> has logged in");
} else {
    world_broadcast("<displayname> has logged in");
}

// client.initialize (L15507-15733) after the tabs: the rules scroll, the rank messages and the
// welcome screen, the logout tab, update(), TextHandler and the bank title. The login broadcast
// (sent in client.run) reaches the chat box at the next cycle, after these messages.
[proc,allstar_welcome]
~allstar_help_main;
if (%allstar_rights = 0) {
    mes("Allstar-Scape");
    mes("Welcome to Allstar-Scape");
    mes("Info on becoming mod type ::modinfo");
    mes("Go to forums at allstarscapeforums.smfforfree2.com");
    mes("Type ::Starter To Begin");
    mes("Server Created By Mod Allstar");
    ~allstar_welcome_screen;
} else if (%allstar_rights = 1) {
    mes("Welcome to Allstar-Scape");
    mes("To shop go east then up north the trail and you will find the shop's");
    mes("Latest Update:   ::suggest (your suggestion)");
    mes("Go to forums at allstarscapeforums.smfforfree2.com");
    mes("Your a Mod... Respect your moderator status");
    mes("Server Created By Mod Allstar");
    ~allstar_welcome_screen;
} else if (%allstar_rights = 2) {
    mes("Welcome to Allstar-Scape");
    mes("To shop go east then up north the trail and you will find the shop's");
    mes("Feel free to spawn w/e u want... NOTHING to other players (cept mods)");
    mes("Go to forums at allstarscapeforums.smfforfree2.com");
    mes("Your Account is Admin...Respect your admin status");
    mes("Server Created By Mod Allstar");
    ~allstar_welcome_screen;
} else if (%allstar_rights = 3) {
    mes("Welcome to Allstar-Scape");
    mes("Do whatever you want");
    mes("Go Own some Noobs owner");
    mes("Go to forums at allstarscapeforums.smfforfree2.com");
    mes("::m to get unlimited money");
    mes("Server Created By Mod Allstar");
    ~allstar_welcome_screen;
}
// L15663: a one-time wipe for one account
if (~allstar_is_named("Motherload11") = true & %allstar_hasset = 0) {
    inv_clear(bank);
    inv_clear(inv);
    mes("Your bank has been reset for abusing dupe/spawn bugs");
    mes("The only reason you're not banned is cos you're my friend");
    mes("So don't abuse any item bugs or expect the same to happen (H) - xero");
    %allstar_hasset = 1;
}
// the logout tab
if_settext(logout:com_0, "Allstar-Scape");
if_settext(logout:com_1, "");
if_settext(logout:com_2, "");
if (namelist_has("macrowarn", displayname) = true) {
    mes("You have 1 black mark as you have been caught autoing...");
    mes("If you are caught autoing again this WILL result in further action being taken");
    mes("against your account.");
}
// update(): the Yes emote label (blanked again by TextHandler) and the logout button
if_settext(controls:com_32, "@blu@Home");
if_settext(logout:try_logout, "Log Out.. Come Back!");
~allstar_texthandler;
if_settext(bank_main:com_90, "@whi@The Official Bank Of <displayname>");
// appendPos, every cycle over the controls tab's weight display (see allstar_process)
if_settext(controls:com_35, "Your coordinates");

// newWelc (client L238): 317 interface 15944 is the Mage Training Arena shop screen (inter_339),
// its texts replaced.
[proc,allstar_welcome_screen]
if_settext(inter_339:com_5, "@gre@~~~ @gre@A@whi@l@gre@l@whi@s@gre@t@whi@a@gre@r@whi@-@gre@S@whi@c@gre@a@whi@p@gre@e @gre@~~~");
if_settext(inter_339:com_15, "");
if_settext(inter_339:com_16, "");
if_settext(inter_339:com_14, "Server created by - Mod Allstar");
if_settext(inter_339:com_6, "");
if_settext(inter_339:com_7, "Reputation: @whi@<tostring(%allstar_reputation)>");
if_settext(inter_339:com_8, "Latest Update - New PkBox!");
if_settext(inter_339:com_9, "Have Fun...");
if_settext(inter_339:com_10, "");
if_settext(inter_339:com_11, "");
if_settext(inter_339:com_12, "");
if_settext(inter_339:com_13, "");
~allstar_showinterface(inter_339);

// loadquestinterface (client L8528): the quest tab, a welcome note. Quest stages: 0 not started,
// -1 complete, else in progress. Clicking the lines does nothing.
[proc,allstar_quest_tab](int $q1, int $q2, int $q3, int $q4)
if_settext(questlist:com_1, "@red@Allstar-Scape");
if_settext(questlist:com_24, "@whi@Info");
if_settext(questlist:com_43, "");
if ($q1 = -1) {
    if_settext(questlist:fortress, "@gre@Invisible Armour");
}
if ($q1 >= 1) {
    if_settext(questlist:fortress, "@yel@Invisible Armour");
}
if ($q1 = 0) {
    if_settext(questlist:fortress, "@whi@Thank you for choosing");
}
if ($q2 = -1 | $q2 >= 1) {
    if_settext(questlist:cook, "@red@Allstar-Scape");
}
if ($q2 = 0) {
    if_settext(questlist:cook, "@yel@Allstar-Scape");
}
if ($q3 = -1) {
    if_settext(questlist:demon, "@gre@Spells Of The Gods");
}
if ($q3 >= 1) {
    if_settext(questlist:demon, "@yel@Spells Of The Gods");
}
if ($q3 = 0) {
    if_settext(questlist:demon, "@whi@We hope you have a great");
}
if ($q4 = -1) {
    if_settext(questlist:doric, "@gre@The Story Of Ramen");
}
if ($q4 >= 1) {
    if_settext(questlist:doric, "@yel@The Story Of Ramen");
}
if ($q4 = 0) {
    if_settext(questlist:doric, "@whi@Good time on our server =)");
}
if_settext(questlist:dragon, "");
if_settext(questlist:haunted, "          - Mod Allstar");
