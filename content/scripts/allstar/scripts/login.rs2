// PlayerHandler.kickNick left over from ::kick, ::banuser or ::macrowarn of a player who was not
// online: this name is kicked
[proc,allstar_kicknick_login]
if (string_length(%allstar_kicknick) > 0 & compare(lowercase(%allstar_kicknick), lowercase(displayname)) = 0) {
    %allstar_kicknick = "";
    p_kick;
}

[proc,allstar_logout]
if (%allstar_rights = 0) {
    world_broadcast("<displayname> has logged out");
}
