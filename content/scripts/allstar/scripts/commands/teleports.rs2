// Allstar-Scape ::teleport commands (client.customCommand). All are instant and keep the current
// height. Most refuse while teleblocked; pest, testminigame, relleka, cwars and gsmini do not.

[proc,cmd_pest]
~allstar_telejump(2657, 2639);

[proc,cmd_testminigame]
~allstar_telejump(3114, 9928);

[proc,cmd_relleka]
~allstar_telejump(2680, 3718);
mes("You teleport to the Rock crab training area");

[proc,cmd_cwars]
~allstar_telejump(2397, 3108);
mes("CastleWars Pk area!");

[proc,cmd_gsmini]
~allstar_telejump(2845, 4832);
mes("Welcome godsword mini game, kill the monsters to advance rounds");
mes("The monsters hp starts at 150 then next monster is 250 and so on");
mes("If you PK here YOUR BANNED!");

[proc,cmd_home]
if (~allstar_teleblocked = true) {
    return;
}
~allstar_telejump(2853, 3591);
mes("You teleport to Home.");

[proc,cmd_jad]
if (~allstar_teleblocked = true) {
    return;
}
~allstar_telejump(3204, 3424);
mes("WELCOME TO THE JAD!!!!!!KILL HIM FOR A FIRECAPE");

