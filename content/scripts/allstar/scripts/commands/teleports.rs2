// ::az (rights >= 1): the Mod & Admin Zone in Sophanem
[proc,allstar_cmd_az]
if (~allstar_teleblocked = true) {
    return;
}
~allstar_telejump(3281, 2766);
mes("You teleport to the Mod & Admin Zone.");
mes("GREAT JOB YOU FINALLY EARNED MOD or ADMIN!");

// ::nc (rights < 2), a trap for noclip clients: teleportToX += 103, teleportToY -= 52 with no
// teleport pending sent the player to 102,-53, off the map. Coordinates cannot be negative on 377,
// so the player lands in the empty map square at 102,0.
[proc,allstar_cmd_nc]
~allstar_telejump(102, 0);
