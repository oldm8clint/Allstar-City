// ::pickup IIIII N (rights >= 2): a five-digit id (zero-padded) and an amount
[proc,allstar_cmd_pickup](string $cmd)
def_boolean $ok = false;
def_int $id = 0;
def_int $amount = 0;
$ok, $id = ~allstar_int_between($cmd, 7, 12);
if ($ok = true) {
    $ok, $amount = ~allstar_int_after($cmd, 13);
}
if ($ok = false) {
    mes("Cmon Type IT AGIAN ! ");
    return;
}
if ($id <= 30000 & $id >= 0) {
    def_namedobj $obj = enum(int, namedobj, allstar_obj_ids, $id);
    if ($obj ! null) {
        ~allstar_additem($obj, $amount);
    }
} else {
    mes("That Item Doesn't Exist");
}
