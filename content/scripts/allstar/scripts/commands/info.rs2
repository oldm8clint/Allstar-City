// Allstar-Scape's info scrolls (client.java L8723-9057 and inline in customCommand): the 317
// scroll 8134 is questjournal. Every menu sets the title, clears the lines (not the title), writes
// its lines, scrolls back to the top (sendQuestSomething 8143) and opens the scroll.

// sendQuestSomething(8143) + showInterface(8134)
[proc,allstar_show_scroll]
if_setscrollpos(questjournal:com_2, 0);
~allstar_showinterface(questjournal);

// ElementalHelpMenu (::armorhelp)
[proc,allstar_help_elemental]
~allstar_scroll_child(8144, "@dre@Elemental Armors");
~allstar_scroll_clear;
~allstar_scroll_child(8145, "@dbl@Elemental Help Guide");
~allstar_scroll_child(8149, "First, buy a gem from the combat instructor.");
~allstar_scroll_child(8151, "Then, buy a pink robe set.");
~allstar_scroll_child(8152, "Use the gem with a peice of the set.");
~allstar_scroll_child(8153, "You now have that type of elemental armor.");
~allstar_scroll_child(8154, "Once you have the full set, you can");
~allstar_scroll_child(8155, "use it to your advantage in the wilderness");
~allstar_scroll_child(8156, "Fire > Earth");
~allstar_scroll_child(8157, "Water > Fire");
~allstar_scroll_child(8158, "Air > Water");
~allstar_scroll_child(8159, "Earth > Air");
~allstar_scroll_child(8160, "There is a 1/10 chance of doing a special attack, but only");
~allstar_scroll_child(8161, "if you're using the full robe set.");
~allstar_scroll_child(8163, "Have fun!");
~allstar_show_scroll;

// the rules, shared by ::modinfo (any rights) and MainHelpMenu
[proc,allstar_rules_lines]
~allstar_scroll_child(8145, "How to Become Mod/Admin");
~allstar_scroll_child(8147, "----");
~allstar_scroll_child(8148, "1. Respect all other players!");
~allstar_scroll_child(8149, "2. Respect Owners,Admins and Mods");
~allstar_scroll_child(8150, "3. Do not start fights with other players");
~allstar_scroll_child(8151, "   just simply tell an Owner or Admin.");
~allstar_scroll_child(8152, "4. Help other players if they need help.");
~allstar_scroll_child(8153, "5. Play on Server alot.");
~allstar_scroll_child(8154, "5. Higher chance if you register on forums at");
~allstar_scroll_child(8155, "allstarscapeforums.smfforfree2.com and stay active");
~allstar_scroll_child(8156, "_____________________________________________________");
~allstar_scroll_child(8157, "If you follow all of these rules you will be fine");
~allstar_scroll_child(8158, "Just follow these and you will become a mod or admin");

// ::modinfo (L12058)
[proc,allstar_cmd_modinfo]
~allstar_scroll_child(8144, "@dre@The rules of Allstar-Scape");
~allstar_scroll_clear;
~allstar_rules_lines;
~allstar_show_scroll;

// MainHelpMenu (L9000; ::mainmenu, ::info, login): text only for rank 0. The design screen check
// needs the look (0,10,18,26,72,42,33), which new characters never have.
[proc,allstar_help_main]
if (%allstar_rights > 0) {
    return;
}
~allstar_scroll_child(8144, "info");
~allstar_scroll_clear;
~allstar_rules_lines;
~allstar_scroll_child(8159, "");
~allstar_show_scroll;

