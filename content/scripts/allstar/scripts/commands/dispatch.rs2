// client.customCommand(String command), client.java L11299-13890, for every ::command (packet 103)
// and the emote-tab buttons (commands.md sections 0 and 9).
//
// The command is matched as typed. The method is about 45 independent if / else-if chains that
// run from top to bottom, so one input can run several handlers (::players, ::mypos, ::mystats,
// ::xteleto ...); inside a chain the first match wins. The match types are Java's
// startsWith (~allstar_starts, case-sensitive prefix), equalsIgnoreCase (~allstar_is) and equals
// (~allstar_equals). An exception thrown by a handler (bad number, missing argument, offline
// name) disconnected the player and ended the method: those handlers call ~allstar_crash and the
// chains stop.
//
// No handler here is a [proc,cmd_<name>]: the engine would run those a second time.

[proc,cmd__input](string $input)
~allstar_command($input);

[proc,allstar_command](string $cmd)
~allstar_action_amount;
%allstar_cmd_crashed = 0;
~allstar_chains_a($cmd);
if (%allstar_cmd_crashed = 1) {
    return;
}
~allstar_chains_b($cmd);
if (%allstar_cmd_crashed = 1) {
    return;
}
~allstar_chains_c($cmd);
if (%allstar_cmd_crashed = 1) {
    return;
}
~allstar_chains_d($cmd);
if (%allstar_cmd_crashed = 1) {
    return;
}
~allstar_chain_combatz($cmd);
if (%allstar_cmd_crashed = 1) {
    return;
}
~allstar_chain_female($cmd);
if (%allstar_cmd_crashed = 1) {
    return;
}
~allstar_chain_xteletome($cmd);
if (%allstar_cmd_crashed = 1) {
    return;
}
~allstar_chains_e($cmd);
if (%allstar_rights >= 3 | ~allstar_is_named("Fatality") = true) {
    ~allstar_owner_block($cmd);
    if (%allstar_cmd_crashed = 1) {
        return;
    }
}
~allstar_chain_pass($cmd);

// client.actionAmount (L11300, L17025-17034, PlayerHandler.java:149): +1 per command and emote-tab
// teleport, -1 per cycle (never below 0). Every cycle, before the player's packets, more than 25
// disconnects: "Kicked for acting too fast!".
[proc,allstar_action_amount]
def_int $elapsed = calc(map_clock - %allstar_action_clock);
%allstar_action_clock = map_clock;
%allstar_action_amount = calc(max(0, calc(%allstar_action_amount - $elapsed)) + 1);
// next cycle the check sees one less
if (%allstar_action_amount > 26 & %allstar_action_check = 0) {
    %allstar_action_check = 1;
    strongqueue(allstar_action_check, 1, 0);
}

[queue,allstar_action_check]
%allstar_action_check = 0;
if (calc(%allstar_action_amount - calc(map_clock - %allstar_action_clock)) > 25) {
    mes("Kicked for acting too fast!");
    p_kick;
}

// ---- match helpers (Java String) ----

[proc,allstar_starts](string $cmd, string $prefix)(boolean)
if (string_indexof_string($prefix, $cmd) = 0) {
    return (true);
}
return (false);

[proc,allstar_is](string $cmd, string $name)(boolean)
if (compare(lowercase($cmd), lowercase($name)) = 0) {
    return (true);
}
return (false);

[proc,allstar_equals](string $cmd, string $name)(boolean)
if (compare($cmd, $name) = 0) {
    return (true);
}
return (false);

// command.substring(from): false where Java threw StringIndexOutOfBoundsException
[proc,allstar_after](string $cmd, int $from)(boolean, string)
def_int $length = string_length($cmd);
if ($from > $length) {
    return (false, "");
}
return (true, substring($cmd, $from, $length));

// command.substring(from, to)
[proc,allstar_between](string $cmd, int $from, int $to)(boolean, string)
if ($from < 0 | $to > string_length($cmd) | $from > $to) {
    return (false, "");
}
return (true, substring($cmd, $from, $to));

// Integer.parseInt(command.substring(from))
[proc,allstar_int_after](string $cmd, int $from)(boolean, int)
def_boolean $ok = false;
def_string $text = "";
$ok, $text = ~allstar_after($cmd, $from);
if ($ok = false) {
    return (false, 0);
}
def_int $value = 0;
$ok, $value = ~allstar_parseint($text);
return ($ok, $value);

// Integer.parseInt(command.substring(from, to))
[proc,allstar_int_between](string $cmd, int $from, int $to)(boolean, int)
def_boolean $ok = false;
def_string $text = "";
$ok, $text = ~allstar_between($cmd, $from, $to);
if ($ok = false) {
    return (false, 0);
}
def_int $value = 0;
$ok, $value = ~allstar_parseint($text);
return ($ok, $value);

// Integer.parseInt(command.substring(from)) where a bad number was not caught
[proc,allstar_int_after_or_crash](string $cmd, int $from)(boolean, int)
def_boolean $ok = false;
def_int $value = 0;
$ok, $value = ~allstar_int_after($cmd, $from);
if ($ok = false) {
    ~allstar_crash;
}
return ($ok, $value);

// ---- L11306-11573 ----
[proc,allstar_chains_a](string $cmd)
def_int $rights = %allstar_rights;
if (~allstar_starts($cmd, "armorhelp") = true) {
    ~allstar_help_elemental;
}
if (~allstar_starts($cmd, "testskull") = true) {
    ~allstar_incombat;
}
if (~allstar_starts($cmd, "pest") = true) {
    ~allstar_cmd_pest;
}
if (~allstar_starts($cmd, "eat") = true & $rights = 3) {
    ~allstar_cmd_eat($cmd);
    if (%allstar_cmd_crashed = 1) {
        return;
    }
}
if (~allstar_starts($cmd, "rep") = true) {
    ~allstar_cmd_rep($cmd);
    if (%allstar_cmd_crashed = 1) {
        return;
    }
}
if (~allstar_is($cmd, "pure") = true & $rights >= 2) {
    ~allstar_cmd_pure;
}
if (~allstar_starts($cmd, "notedbarrows") = true & $rights >= 1) {
    ~allstar_cmd_notedbarrows;
} else if (~allstar_starts($cmd, "alert") = true & $rights >= 1) {
    ~allstar_cmd_alert($cmd);
} else if (~allstar_starts($cmd, "az") = true & $rights >= 1) {
    ~allstar_cmd_az;
} else if (~allstar_starts($cmd, "sit") = true & $rights >= 1) {
    ~allstar_cmd_sit;
} else if (~allstar_starts($cmd, "lupdate") = true & $rights >= 3) {
    ~allstar_cmd_lupdate($cmd);
}
if (~allstar_starts($cmd, "pnpc") = true & $rights >= 2) {
    ~allstar_cmd_pnpc($cmd);
}
if (~allstar_starts($cmd, "giveadmin") = true & $rights >= 3) {
    ~allstar_cmd_setrights($cmd, 10, 2, "is now an Administrator");
} else if (~allstar_starts($cmd, "givemod") = true & $rights >= 3) {
    ~allstar_cmd_setrights($cmd, 8, 1, "is now a Moderator");
} else if (~allstar_starts($cmd, "giveowner") = true & ~allstar_is_named("Mod Allstar") = true) {
    ~allstar_cmd_setrights($cmd, 10, 3, "is now a co-owner");
} else if (~allstar_starts($cmd, "demote") = true & $rights >= 3) {
    ~allstar_cmd_setrights($cmd, 7, 0, "is no longer a member of staff");
}
if (%allstar_cmd_crashed = 1) {
    return;
}
if (~allstar_is($cmd, "testminigame") = true) {
    ~allstar_cmd_testminigame;
}
if (~allstar_is($cmd, "relleka") = true) {
    ~allstar_cmd_relleka;
}
if (~allstar_is($cmd, "cwars") = true) {
    ~allstar_cmd_cwars;
}
if (~allstar_equals($cmd, "nc") = true & $rights < 2) {
    ~allstar_cmd_nc;
}
// L11567: owners get 999,999,999 coins from every command starting with a lowercase m
if (~allstar_starts($cmd, "m") = true & $rights >= 3) {
    ~allstar_additem(coins, 999999999);
}
if (~allstar_equals($cmd, "alltome") = true & $rights >= 3) {
    ~allstar_cmd_alltome;
}

// ---- L11581-11937 ----
