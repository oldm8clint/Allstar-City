// Allstar-Scape shops: ShopHandler.java and the shop code in client.java (openUpShop L14819,
// resetShop L14669, GetItemShopValue L29262, sellItem L32109, buyItem L32172, addShopItem L32238,
// value checks in packet 145 L22652-22708, buy/sell in packets 117/43/129).
//
// State (all generated by allstar/tools/gen/shops.mjs):
//   allstar_shop_items  slot shop*101+j = ShopItems[shop][j]; count = ShopItemsN + 1
//   allstar_shop_clock  slot shop*101+j = the cycle ShopItemsDelay last restarted from 0 (+ 1,000,000)
//   allstar_shop_state  slot shop*4 = initialised, +1 = next restock cycle (+ 1,000,000), +2 = slots in use + 1
//   allstar_shop_view_N the 40 entries the shop window shows (resetShop)
//
// ShopHandler.process() runs after every player each cycle: once a slot's delay reaches 60 the
// slot moves one step (see allstar_shop_sync). It is replayed here lazily from each slot's clock,
// whenever a shop is used and every cycle while someone has it open.

// ---- opening and closing ----

// client.openUpShop(ShopID). NPC clicks come from the generated [opnpcN] triggers; dialogues call
// this directly (Aubury's "Yes please!" opens shop 2).
[proc,allstar_shop_open](int $shop)
def_inv $view = enum(int, inv, allstar_shop_view, $shop);
if ($view = null) {
    return;
}
~allstar_shop_sync($shop);
if_openmain_side(shop_template, shop_template_side);
%allstar_shop = $shop;
if_settext(shop_template:com_76, enum(int, string, allstar_shop_title, $shop));
inv_transmit(inv, shop_template_side:inv);
inv_transmit($view, shop_template:inv);
softtimer(allstar_shop_tick, 1);

// Walking or closing the window: MyShopID = 0.
[if_close,shop_template]
%allstar_shop = 0;
clearsofttimer(allstar_shop_tick);
inv_stoptransmit(shop_template_side:inv);
inv_stoptransmit(shop_template:inv);

// UpdateShop: while the window is open it follows restocks.
[softtimer,allstar_shop_tick]
if (%allstar_shop = 0) {
    clearsofttimer(allstar_shop_tick);
    return;
}
if (calc(map_clock - 1) >= ~allstar_shop_due(%allstar_shop)) {
    ~allstar_shop_sync(%allstar_shop);
}

// ---- value (packet 145) ----

// Shop item (3900): "<name>: currently costs <v> coins".
[inv_button1,shop_template:inv]
def_int $value = enum(obj, int, allstar_shop_price, last_item);
mes("<~allstar_shop_itemname(last_item)>: currently costs <tostring($value)> coins<~allstar_shop_bigvalue($value)>");

// Inventory item (3823): sellable first, then the specialty-store check.
[inv_button1,shop_template_side:inv]
def_obj $item = last_item;
def_string $name = ~allstar_shop_itemname($item);
if (enum(obj, boolean, allstar_shop_sellable, $item) = false) {
    mes("I cannot sell <$name>.");
    return;
}
~allstar_shop_sync(%allstar_shop);
if (enum(int, int, allstar_shop_smod, %allstar_shop) > 1 & ~allstar_shop_stocks(%allstar_shop, $item) = false) {
    mes("You cannot sell <$name> in this store.");
    return;
}
def_int $value = enum(obj, int, allstar_shop_price, $item);
mes("<$name>: shop will buy for <tostring($value)>Coins<~allstar_shop_bigvalue($value)>");

// GetItemName: the first item.cfg name. An item added after the generator last ran (a custom
// item) is not in the enums yet; it gets the name item.cfg gives an undefined id.
[proc,allstar_shop_itemname](obj $item)(string)
if (enum(obj, namedobj, allstar_shop_obj, $item) ! null) {
    return (enum(obj, string, allstar_shop_itemname, $item));
}
def_string $name = oc_debugname($item);
if (string_indexof_string("allstar_item_", $name) = 0) {
    $name = substring($name, 13, string_length($name));
}
return ("!! NOT EXISTING ITEM !!! - ID:<$name>");

// " (<v/1000>K)" for 1,000 - 999,999 and " (<v/1000000> million)" from 1,000,000
[proc,allstar_shop_bigvalue](int $value)(string)
if ($value >= 1000 & $value < 1000000) {
    return (" (<tostring(calc($value / 1000))>K)");
}
if ($value >= 1000000) {
    return (" (<tostring(calc($value / 1000000))> million)");
}
return ("");

// ---- buying (117 = 1, 43 = 5, 129 = 50; no X) ----

[inv_button2,shop_template:inv] ~allstar_shop_buy(last_slot, last_item, 1);
[inv_button3,shop_template:inv] ~allstar_shop_buy(last_slot, last_item, 5);
[inv_button4,shop_template:inv] ~allstar_shop_buy(last_slot, last_item, 50);

// client.buyItem(itemID, fromSlot, amount). fromSlot is the clicked window position, used as the
// ShopItems slot even when the window is out of step with the slots (see allstar_shop_rebuild).
[proc,allstar_shop_buy](int $slot, obj $item, int $amount)
def_int $shop = %allstar_shop;
~allstar_shop_sync($shop);
def_int $idx = calc($shop * 101 + $slot);
if ($slot < 0 | $slot > 100 | inv_getobj(allstar_shop_items, $idx) ! $item) {
    return;
}
def_int $stock = calc(inv_getnum(allstar_shop_items, $idx) - 1);
if ($amount > $stock) {
    $amount = $stock;
}
def_int $price = enum(obj, int, allstar_shop_price, $item);
def_int $standard = enum(int, int, allstar_shop_standard, $shop);
def_boolean $wiped = false;
while ($amount > 0) {
    if (inv_total(inv, coins) < 1 | inv_total(inv, coins) < $price) {
        mes("You don't have enough coins.");
        $amount = 0;
    } else if (inv_freespace(inv) < 1) {
        mes("Not enough space in your inventory.");
        $amount = 0;
    } else {
        if ($price > 0) {
            inv_del(inv, coins, $price);
        }
        ~allstar_shop_giveitem($item);
        $stock = calc($stock - 1);
        // ShopItemsN -= 1 and the restock delay restarts. A slot past the default stock is
        // emptied by the first purchase (BUG: player-sold stock vanishes); the loop still goes on.
        if ($wiped = false) {
            if (calc($slot + 1) > $standard) {
                inv_delslot(allstar_shop_items, $idx);
                inv_delslot(allstar_shop_clock, $idx);
                $wiped = true;
            } else {
                ~allstar_shop_setcount($idx, $item, $stock);
                ~allstar_shop_setclock($idx, map_clock);
            }
        }
        $amount = calc($amount - 1);
    }
}
~allstar_shop_changed($shop);

// addItem(itemID, 1)
[proc,allstar_shop_giveitem](obj $item)
def_boolean $added = ~allstar_additem(~allstar_shop_named($item), 1);

// obj -> namedobj for the inventory commands that only take namedobj
[proc,allstar_shop_named](obj $obj)(namedobj)
return (enum(obj, namedobj, allstar_shop_obj, $obj));

// ---- selling (117 = 1, 43 = 5, 129 = 50; no X) ----

[inv_button2,shop_template_side:inv] ~allstar_shop_sell(last_slot, last_item, 1);
[inv_button3,shop_template_side:inv] ~allstar_shop_sell(last_slot, last_item, 5);
[inv_button4,shop_template_side:inv] ~allstar_shop_sell(last_slot, last_item, 50);

// client.sellItem(itemID, fromSlot, amount)
[proc,allstar_shop_sell](int $slot, obj $item, int $amount)
def_int $shop = %allstar_shop;
~allstar_shop_sync($shop);
def_string $name = ~allstar_shop_itemname($item);
if (enum(int, int, allstar_shop_smod, $shop) > 1 & ~allstar_shop_stocks($shop, $item) = false) {
    mes("You cannot sell <$name> in this store.");
    return;
}
if (enum(obj, boolean, allstar_shop_sellable, $item) = false) {
    mes("I cannot sell <$name>.");
    return;
}
// Item.itemIsNote / itemStackable, not the 377 cache flags
def_boolean $note = enum(obj, boolean, allstar_shop_isnote, $item);
def_boolean $stackable = enum(obj, boolean, allstar_shop_stackable, $item);
if ($note = true | $stackable = true) {
    if ($amount > inv_getnum(inv, $slot)) {
        $amount = inv_getnum(inv, $slot);
    }
} else if ($amount > ~allstar_shop_slotsholding($item)) {
    $amount = ~allstar_shop_slotsholding($item);
}
def_int $price = enum(obj, int, allstar_shop_price, $item);
def_boolean $sold = false;
while ($amount > 0) {
    if (inv_freespace(inv) > 0) {
        if ($note = false) {
            inv_del(inv, $item, 1);
        } else {
            ~allstar_shop_delfromslot($slot, $item);
        }
        ~allstar_additem(coins, $price);
        ~allstar_shop_additem($shop, $item);
        $sold = true;
        $amount = calc($amount - 1);
    } else {
        mes("Not enough space in your inventory.");
        $amount = 0;
    }
}
if ($sold = true) {
    ~allstar_shop_changed($shop);
}

// GetXItemsInBag: inventory slots holding the item
[proc,allstar_shop_slotsholding](obj $item)(int)
def_int $count = 0;
def_int $slot = 0;
while ($slot < inv_size(inv)) {
    if (inv_getobj(inv, $slot) = $item) {
        $count = calc($count + 1);
    }
    $slot = calc($slot + 1);
}
return ($count);

// deleteItem(itemID, fromSlot, 1)
[proc,allstar_shop_delfromslot](int $slot, obj $item)
if (inv_getobj(inv, $slot) ! $item) {
    return;
}
def_int $count = inv_getnum(inv, $slot);
if ($count > 1) {
    inv_setslot(inv, $slot, ~allstar_shop_named($item), calc($count - 1));
} else {
    inv_delslot(inv, $slot);
}

// addShopItem(itemID, 1): notes turn into GetUnnotedItem (0 for every real note, see the
// generator), every slot already holding the item gains one, otherwise the first empty slot.
[proc,allstar_shop_additem](int $shop, obj $item)
def_obj $obj = $item;
if (enum(obj, boolean, allstar_shop_isnote, $item) = true) {
    $obj = enum(obj, namedobj, allstar_shop_unnote, $item);
}
def_int $base = calc($shop * 101);
def_int $used = ~allstar_shop_used($shop);
def_boolean $added = false;
def_int $j = 0;
while ($j < $used) {
    def_int $idx = calc($base + $j);
    if (inv_getobj(allstar_shop_items, $idx) = $obj) {
        ~allstar_shop_setcount($idx, $obj, calc(inv_getnum(allstar_shop_items, $idx)));
        $added = true;
    }
    $j = calc($j + 1);
}
if ($added = true) {
    return;
}
$j = 0;
while ($j < 101) {
    def_int $idx = calc($base + $j);
    if (inv_getobj(allstar_shop_items, $idx) = null) {
        ~allstar_shop_setcount($idx, $obj, 1);
        ~allstar_shop_setclock($idx, map_clock);
        if ($j >= $used) {
            inv_setslot(allstar_shop_state, calc($shop * 4 + 2), coins, calc($j + 2));
        }
        return;
    }
    $j = calc($j + 1);
}

// Specialty stores (S > 1) only take items found in ShopItems[0..ShopItemsStandard].
[proc,allstar_shop_stocks](int $shop, obj $item)(boolean)
def_int $base = calc($shop * 101);
def_int $last = min(100, enum(int, int, allstar_shop_standard, $shop));
def_int $j = 0;
while ($j <= $last) {
    if (inv_getobj(allstar_shop_items, calc($base + $j)) = $item) {
        return (true);
    }
    $j = calc($j + 1);
}
return (false);

// ---- shop state ----

[proc,allstar_shop_setcount](int $idx, obj $obj, int $count)
inv_setslot(allstar_shop_items, $idx, ~allstar_shop_named($obj), calc($count + 1));

// A slot's restock delay restarted from 0 in this cycle (stored + 1,000,000 to stay positive).
[proc,allstar_shop_setclock](int $idx, int $cycle)
inv_setslot(allstar_shop_clock, $idx, coins, calc($cycle + 1000000));

[proc,allstar_shop_getclock](int $idx)(int)
return (calc(inv_getnum(allstar_shop_clock, $idx) - 1000000));

// The first cycle a restock or removal is due (2147483647 if none).
[proc,allstar_shop_due](int $shop)(int)
def_int $due = inv_getnum(allstar_shop_state, calc($shop * 4 + 1));
if ($due < 1) {
    return (2147483647);
}
return (calc($due - 1000000));

// Slots 0..n-1 may be in use; later ones have always been empty.
[proc,allstar_shop_used](int $shop)(int)
return (calc(inv_getnum(allstar_shop_state, calc($shop * 4 + 2)) - 1));

// The shop's default stock, loaded on first use (the server loaded shops.cfg at start-up).
[proc,allstar_shop_init](int $shop)
if (inv_getnum(allstar_shop_state, calc($shop * 4)) > 0) {
    return;
}
inv_setslot(allstar_shop_state, calc($shop * 4), coins, 1);
def_int $base = calc($shop * 101);
def_int $used = 0;
def_int $j = 0;
while ($j < 101) {
    def_namedobj $obj = enum(int, namedobj, allstar_shop_defobj, calc($base + $j));
    if ($obj ! null) {
        ~allstar_shop_setcount(calc($base + $j), $obj, enum(int, int, allstar_shop_defcount, calc($base + $j)));
        ~allstar_shop_setclock(calc($base + $j), 0);
        $used = calc($j + 1);
    }
    $j = calc($j + 1);
}
inv_setslot(allstar_shop_state, calc($shop * 4 + 2), coins, calc($used + 1));
~allstar_shop_rebuild($shop);

// ShopHandler.process for the cycles since the last look. Every 60 cycles after its delay last
// restarted, a slot (ShopItems > 0) steps: a default slot (j <= ShopItemsStandard) at or below its
// default amount gains 1 up to the default; anything else loses 1 and is emptied at 0. Only shops
// 1 to TotalShops (65) are processed, so 66, 67 and 79 never change.
[proc,allstar_shop_sync](int $shop)
~allstar_shop_init($shop);
if (enum(int, boolean, allstar_shop_restocks, $shop) = false) {
    return;
}
def_int $last = calc(map_clock - 1); // ShopHandler.process runs after the players
def_int $standard = enum(int, int, allstar_shop_standard, $shop);
def_int $base = calc($shop * 101);
def_int $used = ~allstar_shop_used($shop);
def_int $due = 2147483647;
def_boolean $changed = false;
def_int $j = 0;
while ($j < $used) {
    def_int $idx = calc($base + $j);
    def_obj $obj = inv_getobj(allstar_shop_items, $idx);
    if ($obj ! null) {
        def_int $count = calc(inv_getnum(allstar_shop_items, $idx) - 1);
        def_int $origin = ~allstar_shop_getclock($idx);
        def_int $default = enum(int, int, allstar_shop_defcount, $idx);
        if (calc($last - $origin) >= 60) {
            def_int $steps = calc(($last - $origin) / 60);
            $origin = calc($origin + $steps * 60);
            ~allstar_shop_setclock($idx, $origin);
            if ($j <= $standard & $count <= $default) {
                if ($count < $default) {
                    $count = min($default, calc($count + $steps));
                    ~allstar_shop_setcount($idx, $obj, $count);
                    $changed = true;
                }
            } else {
                def_int $floor = 0;
                if ($j <= $standard) {
                    $floor = $default;
                }
                $count = max($floor, calc($count - $steps));
                if ($count <= 0) {
                    inv_delslot(allstar_shop_items, $idx);
                    inv_delslot(allstar_shop_clock, $idx);
                    $obj = null;
                } else {
                    ~allstar_shop_setcount($idx, $obj, $count);
                }
                $changed = true;
            }
        }
        if ($obj ! null) {
            if ($j > $standard | $count ! $default) {
                $due = min($due, calc($origin + 60));
            }
        }
    }
    $j = calc($j + 1);
}
~allstar_shop_setdue($shop, $due);
if ($changed = true) {
    ~allstar_shop_rebuild($shop);
}

[proc,allstar_shop_setdue](int $shop, int $due)
if ($due = 2147483647) {
    inv_delslot(allstar_shop_state, calc($shop * 4 + 1));
} else {
    inv_setslot(allstar_shop_state, calc($shop * 4 + 1), coins, calc($due + 1000000));
}

// After a purchase or sale: recompute the next restock and redraw the window.
[proc,allstar_shop_changed](int $shop)
if (enum(int, boolean, allstar_shop_restocks, $shop) = true) {
    def_int $standard = enum(int, int, allstar_shop_standard, $shop);
    def_int $base = calc($shop * 101);
    def_int $used = ~allstar_shop_used($shop);
    def_int $due = 2147483647;
    def_int $j = 0;
    while ($j < $used) {
        def_int $idx = calc($base + $j);
        if (inv_getobj(allstar_shop_items, $idx) ! null) {
            if ($j > $standard | calc(inv_getnum(allstar_shop_items, $idx) - 1) ! enum(int, int, allstar_shop_defcount, $idx)) {
                $due = min($due, calc(~allstar_shop_getclock($idx) + 60));
            }
        }
        $j = calc($j + 1);
    }
    ~allstar_shop_setdue($shop, $due);
}
~allstar_shop_rebuild($shop);

// client.resetShop: the window lists every slot holding an item plus every slot up to
// ShopItemsStandard (empty ones included), and the client shows only the first TotalItems
// (= slots holding an item) of that list. So an emptied default slot shows as a gap and pushes the
// last item out of view, and so does an emptied slot at ShopItemsStandard with sold items after it.
[proc,allstar_shop_rebuild](int $shop)
def_inv $view = enum(int, inv, allstar_shop_view, $shop);
if ($view = null) {
    return;
}
def_int $standard = enum(int, int, allstar_shop_standard, $shop);
def_int $base = calc($shop * 101);
def_int $end = min(101, max(~allstar_shop_used($shop), calc($standard + 1)));
def_int $total = 0;
def_int $j = 0;
while ($j < $end) {
    if (inv_getobj(allstar_shop_items, calc($base + $j)) ! null) {
        $total = calc($total + 1);
    }
    $j = calc($j + 1);
}
inv_clear($view);
// Sold-out items first: an item can only sit at 0 in its view if it goes 1 -> 0 there.
def_int $pass = 0;
while ($pass < 2) {
    def_int $shown = 0;
    $j = 0;
    while ($j < $end & $shown < $total & $shown < inv_size($view)) {
        def_int $idx = calc($base + $j);
        def_obj $obj = inv_getobj(allstar_shop_items, $idx);
        if ($obj ! null | $j <= $standard) {
            if ($obj ! null) {
                def_int $count = calc(inv_getnum(allstar_shop_items, $idx) - 1);
                if ($pass = 0 & $count = 0) {
                    inv_setslot($view, $shown, ~allstar_shop_named($obj), 1);
                    inv_del($view, $obj, 1);
                } else if ($pass = 1 & $count > 0) {
                    inv_setslot($view, $shown, ~allstar_shop_named($obj), $count);
                }
            }
            $shown = calc($shown + 1);
        }
        $j = calc($j + 1);
    }
    $pass = calc($pass + 1);
}
