    case magic :
        ~allstar_levelup_box(levelup_magic, levelup_magic:line1, levelup_magic:line2, "Congratulations, you just advanced a magic level!", "Your magic level is now <tostring($level)> .");
        mes("Congratulations, you just advanced a magic level.");
        if ($level >= 99) {
            // ~allstar_additem(allstar_item_14088, 1);
            // addItem(14089, 5): not stackable, so one
            // ~allstar_additem(allstar_item_14089, 5);
            mes("Congratulations, you just recived the Mage skill cape");
            world_broadcast("<displayname> has just gotten <tostring($level)> magic!");
        }
    case cooking :
        mes("Congratulations, you just advanced a cooking level.");
        if ($level >= 99) {
            ~allstar_additem(coins, 10000000);
            // ~allstar_additem(allstar_item_14128, 1);
            mes("Congratulations, you just recived the cooking skill cape and hood!");
