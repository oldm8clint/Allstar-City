// sendFrame164(chatbox), stillgfx(199, absX, absY), the two lines
[proc,allstar_levelup_box](interface $chatbox, component $line1, component $line2, string $title, string $body)
tut_open($chatbox);
%allstar_levelup_box = coord;
~allstar_stillgfx(levelup_anim, coordz(coord), coordx(coord));
if_settext($line1, $title);
if_settext($line2, $body);
