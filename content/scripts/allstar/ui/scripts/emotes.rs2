// Allstar-Scape's emote tab (client.java L23769-23898). Button handlers:
// content/scripts/interface_controls/scripts/player_controls.rs2.

// Yes, No, Bow, Angry, Laugh, Cheer, Wave, Beckon, Clap, Dance: teleblock, then customCommand
[proc,allstar_emote_teleport](string $command)
if (~allstar_teleblocked = true) {
    return;
}
~allstar_command($command);

// Think (162): "vengeance". With the action timer free: 5 seconds of cooldown, graphic 401, the
// logout delay, a hit of 0-17 with graphic 600 on every other player within one tile (any height)
// who is outside the safe zones, the attack animation and a shout. "You use vengence!" every time.
[proc,allstar_vengeance]
if (~allstar_action_timer = 0) {
    ~allstar_set_action_timer(10);
    ~allstar_gfx_id(401, coordx(coord), coordz(coord));
    // strPot / strPotTimer are set but nothing reads them
    ~allstar_incombat;
    ~allstar_attack_players_within(600, 17, 1);
    ~allstar_anim_id(2890);
    say("Die Like The Rest Bitch...!");
    if_close;
}
mes("You use vengence!");

// client.attackPlayersWithin is combat's ~allstar_attack_players_within (allstar/combat/scripts/magic_player.rs2):
// Allstar-Scape hits, the finishing blow bug and KillerId.

// Cry (161): capeEmote (C:1066). Per worn cape: graphics on the player's tile, an animation, an
// overhead text and the skill's current level set to its base level + 1. (The level was also
// written to 317 component 4016; the 377 stats tab draws its own numbers.) Most capes are Allstar
// custom items (from the customitems workstream, allstar_item_<id>): their entries are commented
// out until those objs exist.
[proc,allstar_cape_emote]
def_obj $cape = inv_getobj(worn, ^wearpos_back);
if ($cape = null) {
    return;
}
switch_obj ($cape) {
    // 7638 "Silvthrill rod": the text is set but never sent (no string4UpdateRequired)
    case burgh_rod_command2 :
        ~allstar_cape_gfx(267, 255, 259, 352);
    case burgh_book_historiesofhallowland :
        ~allstar_cape_gfx(422, 60, 62, -1);
        ~allstar_anim_id(747);
        say("An agility skill cape.");
    case poh_wooden_shield :
        ~allstar_cape_gfx(350, 448, 474, -1);
        say("A hunter skill cape.");
