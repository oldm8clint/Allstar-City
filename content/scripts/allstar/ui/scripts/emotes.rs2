// up to four stillgfx on the player's tile (-1: none)
[proc,allstar_cape_gfx](int $gfx1, int $gfx2, int $gfx3, int $gfx4)
def_int $x = coordx(coord);
def_int $z = coordz(coord);
if ($gfx1 ! -1) {
    ~allstar_gfx_id($gfx1, $x, $z);
}
if ($gfx2 ! -1) {
    ~allstar_gfx_id($gfx2, $x, $z);
}
if ($gfx3 ! -1) {
    ~allstar_gfx_id($gfx3, $x, $z);
}
if ($gfx4 ! -1) {
    ~allstar_gfx_id($gfx4, $x, $z);
}

// playerLevel[skill] = getLevelForXP(xp) + 1
[proc,allstar_cape_boost](stat $stat)
def_int $target = calc(stat_base($stat) + 1);
def_int $current = stat($stat);
if ($current < $target) {
    stat_add($stat, calc($target - $current), 0);
} else if ($current > $target) {
    stat_sub($stat, calc($current - $target), 0);
}
