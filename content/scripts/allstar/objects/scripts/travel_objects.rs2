// Allstar-Scape stairs, doors that teleport, webs, agility shortcuts and the Tears of Guthix rocks
// (allstar/spec/objects_buttons.md sections 3.1, 3.8, 3.10, 3.12). Positions are the player's own at
// the moment of the click (absX / absY), levels change like heightLevel did.

// Slayer Tower door 4487: heightLevel = 0 first, then through the door
[label,allstar_slayertower_door]
def_int $z = coordz(coord);
if ($z = 3535) {
    ~allstar_obj_tele(3428, 3536, 0);
} else if ($z = 3536) {
    ~allstar_obj_tele(3428, 3535, 0);
}

// 10527 (x 3426) / 10529 (x 3427): heightLevel = 1
[label,allstar_slayertower_upper_door](int $x, int $level)
def_int $z = coordz(coord);
if ($z = 3555) {
    ~allstar_obj_tele($x, 3556, $level);
} else if ($z = 3556) {
    ~allstar_obj_tele($x, 3555, $level);
}

// 5126: heightLevel = 2
[label,allstar_slayertower_top_door]
def_int $z = coordz(coord);
if ($z = 3555) {
    ~allstar_obj_tele(3445, 3554, 2);
} else if ($z = 3554) {
    ~allstar_obj_tele(3445, 3555, 2);
}

// Mage bank webs 733 (no knife needed): later matches override earlier ones
[label,allstar_magebank_web]
def_int $x = coordx(coord);
def_int $z = coordz(coord);
def_int $tx = -1;
def_int $tz = -1;
if ($x = 3092) {
    $tx = 3093;
    $tz = 3957;
}
if ($x = 3093) {
    $tx = 3092;
    $tz = 3957;
}
if ($x = 3094) {
    $tx = 3095;
    $tz = 3957;
}
if ($x = 3095) {
    $tx = 3094;
    $tz = 3957;
}
if ($z = 3950) {
    $tx = 3158;
    $tz = 3952;
}
if ($z = 3952) {
    $tx = 3158;
    $tz = 3950;
}
if ($z = 3119) {
    $tx = $x;
    $tz = 3118;
}
if ($z = 3118) {
    $tx = $x;
    $tz = 3119;
}
if ($z = 3957) {
    $tx = $x;
    $tz = 3959;
}
if ($z = 3959) {
    $tx = coordx(loc_coord);
    $tz = 3957;
}
if ($tx ! -1) {
    ~allstar_obj_tele_here($tx, $tz);
}

// Yanille agility dungeon monkey bars 2321: each direction prints both failure lines when its own
// check fails, so even a successful swing prints the other direction's two lines.
[label,allstar_monkeybars]
def_int $x = coordx(coord);
def_int $z = coordz(coord);
if ($z < 9487 | $z > 9495) {
    return;
}
def_int $agility = stat(agility);
def_int $tz = -1;
if ($z = 9494 & $agility >= 80) {
    $tz = 9488;
    mes("You swing across the monkey bars.");
    stat_advance(agility, multiply(40, $agility));
} else {
    mes("You need an agility level of 80 to climb the monkey bars.");
    mes("You need to be wearing goldsmith gaunlets to climb the monkey bars.");
}
if ($z = 9488 & $agility >= 80 & inv_getobj(worn, ^wearpos_hands) = gauntlets_of_goldsmithing) {
    $tz = 9494;
    mes("You swing accross the monkey bars.");
} else {
    mes("You need an agility level of 80 to climb the monkey bars.");
    mes("You need to be wearing goldsmith gaunlets to climb the monkey bars.");
}
if ($tz ! -1) {
    ~allstar_obj_tele_here($x, $tz);
}

// Balancing ledge 2303
[label,allstar_balancing_ledge]
def_int $x = coordx(coord);
def_int $z = coordz(coord);
def_int $agility = stat(agility);
def_int $tz = -1;
if ($z = 9520 & $agility >= 80) {
    $tz = 9512;
    mes("You climb accross the ledge.");
    stat_advance(agility, multiply(40, $agility));
} else if ($z = 9520 & $agility <= 80) {
    mes("You need an agility level of 80 to climb this ledge.");
}
if ($z = 9512 & $agility >= 80) {
    $tz = 9520;
    mes("You climb accross the ledge.");
} else if ($z = 9512 & $agility <= 80) {
    mes("You need an agility level of 80 to climb this ledge.");
}
if ($tz ! -1) {
    ~allstar_obj_tele_here($x, $tz);
}

// Staircase 1733: the Yanille one needs goldsmith gauntlets, every other one goes 6397 north
[label,allstar_goldsmith_stairs]
if (~allstar_objat(2603, 3078) = true) {
    if (inv_getobj(worn, ^wearpos_hands) = gauntlets_of_goldsmithing) {
        ~allstar_obj_tele_here(coordx(coord), calc(coordz(coord) + 6397));
    } else {
        mes("You need to be wielding goldsmith gaunlets to use these stairs.");
    }
} else {
    ~allstar_obj_tele_here(coordx(coord), calc(coordz(coord) + 6397));
}

// Trap staircase 1728 into the King Black Dragon's damage zone: 10-15 damage to the separate
// currentHealth pool (the Hitpoints stat is only shown hit), actionTimer 30
[label,allstar_trap_stairs]
if (coordz(loc_coord) ! 9497) {
    return;
}
mes("You climb down the stairs, and stand on a trap!");
~allstar_obj_tele_here(2636, 9517);
~allstar_zone_hit(calc(10 + randominc(5)));
~allstar_action_timer(30);

// Tears of Guthix climbing rocks 6672 / 6673 (Mod Allstar): from the east two steps west, from the
// west two steps east, 5 cycles apart (actionTimer), then animation 1
[label,allstar_tog_rocks]
def_int $lx = coordx(loc_coord);
if ($lx ! 3239 & $lx ! 3240) {
    return;
}
if (coordx(coord) > $lx) {
    anim(human_climbing_down, 0);
    ~allstar_action_timer(5);
    %allstar_climb_stage = 1;
    softtimer(allstar_climb, 1);
} else if (coordx(coord) < $lx) {
    facesquare(movecoord(coord, -1, 0, 0));
    anim(human_climbing_down, 0);
    %allstar_climb_stage = 100;
    softtimer(allstar_climb, 1);
}

[softtimer,allstar_climb]
if (%allstar_climb_stage = 0) {
    clearsofttimer(allstar_climb);
    return;
}
if (~allstar_action_ready = false) {
    return;
}
if (p_finduid(uid) = false) {
    return;
}
if (%allstar_climb_stage = 1) {
    p_telejump(movecoord(coord, -1, 0, 0));
    ~allstar_action_timer(5);
    %allstar_climb_stage = 2;
} else if (%allstar_climb_stage = 2) {
    p_telejump(movecoord(coord, -1, 0, 0));
    anim(swarm_attack, 0);
    %allstar_climb_stage = 0;
} else if (%allstar_climb_stage = 100) {
    p_telejump(movecoord(coord, 1, 0, 0));
    ~allstar_action_timer(5);
    %allstar_climb_stage = 101;
} else if (%allstar_climb_stage = 101) {
    p_telejump(movecoord(coord, 1, 0, 0));
    anim(swarm_attack, 0);
    %allstar_climb_stage = 0;
}
