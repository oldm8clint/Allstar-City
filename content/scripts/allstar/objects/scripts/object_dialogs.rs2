// Allstar-Scape object menus: the clan portal, Juna, the bank booth banker, the spellbook altar and
// the scoreboard (allstar/spec/objects_buttons.md sections 2, 3.1, 3.11, 3.13).
//
// Two-option chat buttons were one global handler (button 9157 = option 1, 9158 = option 2) that
// looked at NpcDialogue, OptionObject and JunaTele in a fixed order. In normal play NpcDialogue is 0,
// so the first "option 1" of the clan portal or Juna is swallowed by the NpcDialogue == 0 branch
// ("Mmk thanks for reading!" + Hans' "Select an Option" box); NpcDialogue then stays 1340, which makes
// option 2 of a later menu say "Fine, you suck!" instead of acting.

// selectoption(question, s1, s2, "") (client.java L10219)
[proc,allstar_selectoption](string $question, string $option1, string $option2)(int)
def_int $choice = ~p_choice2_header($option1, 1, $option2, 2, $question);
return($choice);

// clan portal 2466 (actionTimer checked by the caller)
[label,allstar_clan_portal]
%allstar_option_object = 2466;
@allstar_option_button(~allstar_selectoption("@whi@W@gre@h@whi@e@gre@r@whi@e @whi@d@gre@o @whi@y@gre@o@whi@u @whi@w@gre@a@whi@n@gre@t @whi@t@gre@o @whi@g@gre@o@whi@?", "@red@Saradomin's Clan", "@red@Zamorak's Clan"));

// Juna 6657: which side of the snake the player stands on picks the destination
[label,allstar_juna]
if (coordx(coord) < coordx(loc_coord)) {
    %allstar_junatele = 1;
} else if (coordx(coord) > coordx(loc_coord)) {
    %allstar_junatele = 2;
} else {
    return;
}
@allstar_option_button(~allstar_selectoption("Hello what do you want?", "Can I go through please?", "Ya ma."));

// buttons 9157 / 9158, as far as the objects are concerned
[label,allstar_option_button](int $choice)
if ($choice = 1) {
    if (%allstar_npcdialogue = 0) {
        %allstar_npcdialogue = 1340;
        // sendFrame126("Mmk thanks for reading!", 4885) went to a chat box that was not open
        if_close;
        // next cycle: UpdateNPCChat case 1340
        p_delay(0);
        @allstar_option_button(~allstar_selectoption("Select an Option", "Yea i wanna go own n00bs!", "Nah im really scared!"));
    }
    if (%allstar_option_object = 2466) {
        mes("Welcome to Saradomin's team!");
        ~allstar_obj_tele_here(2387, 3116);
        %allstar_option_object = -1;
        if_close;
    } else if (%allstar_junatele = 1) {
        if_close;
        ~allstar_obj_tele_here(3253, coordz(coord));
        %allstar_junatele = -1;
    } else if (%allstar_junatele = 2) {
        if_close;
        ~allstar_obj_tele_here(3251, coordz(coord));
        %allstar_junatele = -1;
    }
    return;
}
if (%allstar_npcdialogue = 1340) {
    %allstar_npcdialogue = 0;
    // sendFrame126("Fine, you suck!", 4885), again to a closed chat box
    if_close;
} else if (%allstar_option_object = 2466) {
    mes("Welcome to Zamorak's team!");
    ~allstar_obj_tele_here(2412, 3091);
    %allstar_option_object = -1;
    if_close;
}
if (%allstar_junatele = 1 | %allstar_junatele = 2) {
    %allstar_junatele = -1;
    // player chat head on interface 973 with animation 615
    if_setplayerhead(chat2:com_0);
    if_setanim(chat2:com_0, chatang2);
    if_settext(chat2:com_1, displayname);
    if_settext(chat2:com_2, "Ya ma.");
    if_settext(chat2:com_3, "");
    if_openchat(chat2);
}

// Bank booth 2213, first option: once the player stands next to the booth (GoodDistance2 1), the NPC
// on the tile south of it greets them (NpcDialogue 1 -> 2). No NPC there meant npc type 1 (Man).
[label,allstar_bankbooth_talk](boolean $ap)
if (~allstar_gooddistance2(loc_coord, 1) = false) {
    if ($ap = true) {
        p_aprange(1);
    }
    return;
}
def_coord $spot = movecoord(loc_coord, 0, 0, -1);
def_npc $npc = man;
npc_findallany($spot, 0, 0);
while (npc_findnext = true) {
    if (npc_coord = $spot) {
        $npc = npc_type;
    }
}
if_setnpchead(npcchat1:com_0, $npc);
if_setanim(npcchat1:com_0, chatneu4);
if_settext(npcchat1:com_1, nc_name($npc));
if_settext(npcchat1:com_2, "Good day, how can I help you?");
if_openchat(npcchat1);
p_pausebutton;
def_int $choice = ~allstar_selectoption("What would you like to say?", "I'd like to access my bank account, please.", "I'd like to check my PIN settings.");
if ($choice = 1) {
    @openbank;
}
@open_bank_pin_setting;

// Spellbook altar 6552. objectClick (only within 1 tile) toggled playerAncientMagics; the packet 132
// code then toggled ancients and the spellbook. From a fresh login the first click therefore says
// "You convert to normal magic.".
[label,allstar_ancient_altar]
if (distance(coord, loc_coord) <= 1) {
    if (%allstar_ancient_magics = 1) {
        if_settab(magic, ^tab_magic);
        %allstar_ancient_magics = 0;
        %allstar_ancients = 0;
    } else {
        if_settab(inter_267, ^tab_magic);
        if_settab(magic, ^tab_magic);
        %allstar_ancients = 1;
        %allstar_ancient_magics = 1;
    }
}
if (%allstar_ancients = 0) {
    %allstar_emotes = 2;
    if_settab(inter_267, ^tab_magic);
    %allstar_ancients = 1;
    mes("You convert to ancient magic.");
} else if (%allstar_ancients = 1) {
    %allstar_emotes = 0;
    if_settab(magic, ^tab_magic);
    %allstar_ancients = 0;
    mes("You convert to normal magic.");
}

// Scoreboard 3192: playerMenu() (client.java L8979)
[proc,allstar_scoreboard]
~allstar_scroll_clear;
~allstar_scroll_child(8144, "@dre@Players");
~allstar_scroll_child(8146, "@red@Allstar-Scape");
def_int $line = 1;
playerall;
while (.huntnext = true) {
    ~allstar_scroll_line($line, "@red@<.displayname>");
    $line = calc($line + 1);
}
if_openmain(questjournal);
