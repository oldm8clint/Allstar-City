    case ladder, loc_1750, loc_1738, stairs, loc_1734, tunnelstairstop, tunnelstairstop2, swamp_cave_climbing_rope, loc_1757, wizards_tower_ladder, agility_ticketpillar, entranaladdertop, thrt_tavern_trap_door, loc_5131, loc_9359, blankrunestone_exit_portal, zanarisdoor, ahoy_tower_stairs_lv1, barrows_stairs_verac, barrows_stairs_torag, barrows_stairs_karil, barrows_stairs_guthan, barrows_stairs_dharok, barrows_stairs_ahrim, mm_bamboo_ladder :
        anim(human_reachforladder, 0);
        ~allstar_obj_tele(coordx(coord), coordz(coord), calc(coordy(coord) + 1));
    case tog_climbing_rocks_down, tog_climbing_rocks_up :
        @allstar_tog_rocks;
    case default :
        @allstar_objectclick_none($ap);
}

// ---- objectClick2 (client.java L4286) ----
[label,allstar_objectclick2](boolean $ap)
switch_loc (loc_type) {
    case bankbooth, loc_2214, chest_10_coins, newbiebankbooth, ahoy_bankbooth, dwarf_keldagrim_bankbooth, loc_11758 :
        @openbank;
    case gem_stall_stealing :
        ~allstar_theifstall("gem stall", "and recieve 3m", 60, multiply(500, stat(thieving)), coins, 3000000, 30);
    case mm_stall_scimitar :
        ~allstar_theifstall("scimitar stall", "and recieve 2m", 40, multiply(300, stat(thieving)), coins, 2000000, 30);
    case mm_stall_magic :
        ~allstar_theifstall("magic stall", "and recieve 1m", 20, multiply(125, stat(thieving)), coins, 1000000, 30);
    case mm_stall_general :
        ~allstar_theifstall("general stall", "and recieve 500k", 1, multiply(70, stat(thieving)), coins, 500000, 15);
    case silk_stall_stealing :
        ~allstar_theifstall("silk stall", "and recieve 9m", 99, multiply(20, stat(thieving)), coins, 9000000, 30);
    case misc_fish_market :
        ~allstar_theifstall("Fish stall", "and recieve a manta ray", 1, multiply(500, stat(thieving)), raw_mantaray, 1, 30);
    case misc_veg_market :
        ~allstar_theifstall("Veg Stall", "and recieve money???", 1, multiply(500, stat(thieving)), coins, 100000, 30);
    case silver_stall_stealing :
        ~allstar_theifstall("silver stall", "and recieve 5m", 80, multiply(750, stat(thieving)), coins, 5000000, 30);
    case tea_stall :
        ~allstar_theifstall(".", ".", 1, multiply(5, stat(thieving)), coins, 250, 30);
    // loc_1739 only changed the server's heightLevel without telling the client (JUNK, not ported).
    // The clue scroll steps on drawers1 / crate_old / crate2_old belong to the clue scroll system.
    case default :
        @allstar_objectclick_none($ap);
}

