// Allstar-Scape object clicks (client.java packets 132 / 252 / 70 -> objectClick / objectClick2 /
// objectClick3, allstar/spec/objects_buttons.md sections 2-4).
//
// Allstar-Scape ran a handler as soon as the player was within Chebyshev distance 2 of the clicked
// loc's coordinate (GoodDistance: no line of sight, height ignored), otherwise it walked the player
// there first. Every loc id with a case behaves the same wherever it is; locs without a case do
// nothing, silently. The ap triggers reproduce the reach (p_aprange keeps the player walking) and the
// op triggers catch locs the ap check cannot see (behind walls, doors). A loc without an Allstar
// handler is left to the op triggers (p_aprange 0), so specific [oploc*,<loc>] scripts still run.

[aploc1,_]
// packet 132 opened the deposit box at click time, before any range check
if (loc_type = loc_9398) {
    ~allstar_open_deposit_box;
}
def_int $range = ~allstar_objectclick1_range(loc_type);
if (distance(coord, loc_coord) > $range) {
    p_aprange($range);
    return;
}
@allstar_objectclick1(true);

[oploc1,_]
if (loc_type = loc_9398) {
    ~allstar_open_deposit_box;
}
if (distance(coord, loc_coord) > ~allstar_objectclick1_range(loc_type)) {
    return;
}
@allstar_objectclick1(false);

[aploc2,_]
def_int $range = ~allstar_objectclick23_range(loc_type);
if (distance(coord, loc_coord) > $range) {
    p_aprange($range);
    return;
}
@allstar_objectclick2(true);

[oploc2,_]
if (distance(coord, loc_coord) > ~allstar_objectclick23_range(loc_type)) {
    return;
}
@allstar_objectclick2(false);

[aploc3,_]
def_int $range = ~allstar_objectclick23_range(loc_type);
if (distance(coord, loc_coord) > $range) {
    p_aprange($range);
    return;
}
@allstar_objectclick3(true);

[oploc3,_]
if (distance(coord, loc_coord) > ~allstar_objectclick23_range(loc_type)) {
    return;
}
@allstar_objectclick3(false);

// packet 234 (fourth option) only printed debug output and the fifth option had no handler
[oploc4,_]
[oploc5,_]

// destinationRange: 2, but 6912 needed 3 and the first option of the Tears of Guthix rocks 1
[proc,allstar_objectclick1_range](loc $loc)(int)
if ($loc = lost_tribe_hole_2) {
    return(3);
}
if ($loc = tog_climbing_rocks_down | $loc = tog_climbing_rocks_up) {
    return(1);
}
return(2);

[proc,allstar_objectclick23_range](loc $loc)(int)
if ($loc = lost_tribe_hole_2) {
    return(3);
}
return(2);

// openUpDepBox() (client.java L328)
// A loc without an Allstar-Scape handler: an ap trigger lets the op triggers have it.
[label,allstar_objectclick_none](boolean $ap)
if ($ap = true) {
    p_aprange(0);
}

// true when the clicked loc is at (x, z) on any level (Allstar-Scape compared objectX/objectY only)
[proc,allstar_objat](int $x, int $z)(boolean)
if (coordx(loc_coord) = $x & coordz(loc_coord) = $z) {
    return(true);
}
return(false);

