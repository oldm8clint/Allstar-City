// Allstar-City: the spell triggers are Allstar-Scape's magic (allstar/combat/scripts/magic*.rs2).
[timer,charge]
%magearena_charge = sub(%magearena_charge, 1);
if (%magearena_charge < 1) {
    mes("Your magical charge fades away."); // https://youtu.be/nRiXrgWEJ40?t=12
    sound_synth(charge_gone, 1, 0);
    cleartimer(charge);
    return;
}
