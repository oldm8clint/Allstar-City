// Allstar-City: Allstar-Scape has no wilderness overlay and no wilderness-only Attack option. The map
// outside the safe zones is a PvP area (~allstar_nonwild), the Safe/Wild overlay is ui's
// allstar_walkable and the player options are set once at login.
[proc,wilderness_enter]
%wilderness = ^true;

[proc,wilderness_underground_enter]
%wilderness = ^true;

[proc,wilderness_exit]
