// Allstar-City: deposits, withdrawals and the note toggle are Allstar-Scape's
// (content/scripts/allstar/items/scripts/bank.rs2). @openbank stays the entry point used by the
// Lost City bankers and booths.
[label,openbank]
~allstar_open_bank;

[if_close,bank_main] @closebank;

[label,closebank]
inv_stoptransmit(bank_side:inv);
inv_stoptransmit(bank_main:bank);
