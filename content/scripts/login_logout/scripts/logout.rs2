[logout,_]
~allstar_logout;
~set_pk_skull_logout;
~set_antifire_logout; // TODO: should be timer
~follower_logout;
~duel_arena_logout;
~macro_event_logout;
~castlewars_logout;
%last_logout = map_clock;

// Allstar-Scape button 9154: refused only during the logout delay after combat (~allstar_incombat)
[if_button,logout:try_logout]
if_close;
if (map_clock < %allstar_logout_delay) {
    mes("You must wait 10 seconds after combat to log out!");
    return;
}
if (p_finduid(uid) = true) {
    p_logout;
}

[proc,combat_preventlogout]
p_preventlogout("You can't log out until 10 seconds after the end of combat.", 16);

[proc,.combat_preventlogout]
.p_preventlogout("You can't log out until 10 seconds after the end of combat.", 16);
