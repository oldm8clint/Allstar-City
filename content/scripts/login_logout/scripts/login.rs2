// Allstar-City: Allstar-Scape login (client.run, client.initialize). No tutorial, random events
// or Lost City login side effects; see allstar/spec/npcs_rules.md section 5.
[login,_]
cam_reset;

if (%option_brightness = 0) {
    // sane defaults for game controls
    %option_brightness = 2;
    %option_music = 2;
    %option_sounds = 2;
}
minimap_toggle(0); //reset minimap state on login

~allstar_new_player;
~allstar_login_rights;

// right-click options on other players (client.run L10923-10957)
set_player_op("@whi@T@gre@r@whi@a@gre@d@whi@e @whi@w@gre@i@whi@t@gre@h", 4, ^false);
if (%allstar_rights <= 2) {
    set_player_op("@whi@F@gre@o@whi@l@gre@l@whi@o@gre@w", 2, ^false);
} else {
    set_player_op("@whi@B@gre@a@whi@n", 2, ^false);
}
set_player_op("@whi@A@gre@t@whi@t@gre@a@whi@c@gre@k", 3, ^true);
if (%allstar_rights > 0 | ~allstar_is_named("D D 3") = true) {
    set_player_op("@whi@K@gre@i@whi@c@gre@k", 5, ^false);
} else {
    set_player_op(null, 5, ^false);
}

~initalltabs;
~update_all(inv_getobj(worn, ^wearpos_rhand));
~allstar_welcome;

[proc,initalltabs]
~update_weapon_category(inv_getobj(worn, ^wearpos_rhand));
if_settab(stats, ^tab_skills);
if_settab(questlist, ^tab_quest_journal);
~update_questlist;

inv_transmit(inv, inventory:inv);
inv_transmit(worn, wornitems:worn);

if_settab(inventory, ^tab_inventory);
if_settab(wornitems, ^tab_wornitems);

if_settab(prayer, ^tab_prayer);
if_settab(magic, ^tab_magic);
if_settab(friends, ^tab_friends);
if_settab(ignore, ^tab_ignore);
if_settab(logout, ^tab_logout);
if_settab(controls, ^tab_player_controls);
if (lowmem = true) {
    if_settab(options_ld, ^tab_game_options);
    if_settab(music_ld, ^tab_musicplayer);
} else {
    if_settab(options, ^tab_game_options);
    if_settab(music, ^tab_musicplayer);
}
